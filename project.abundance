          ],
          "interpreterVersion": 1,
          "code": "/**\n * The keel batten (keelson) set into the frames' keel notches, lofted along the keel line from the shared\n * Hull Lines table (wired in), from the transom to just past the stem scarf. Its underside is bevelled to the\n * bottom's deadrise at every station so it stays inside the planking.\n */\nfunction stationAt(L: any, y: number): any {\n  // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n  const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n  const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n    sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n  const st = [tr, ...L.stations];\n  const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n  const n = st.length;\n  if (y <= st[0].y) return st[0];\n  if (y >= st[n - 1].y) return st[n - 1];\n  let i = 0;\n  while (i < n - 2 && y > st[i + 1].y) i++;\n  const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n  const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n  const out: any = { y };\n  for (const k of keys) {\n    const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n    const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n    out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n  }\n  return out;\n}\n// Smooth keel / stem profile through the table's keel points: returns [y, z] samples from y0 to y1.\nfunction keelProfile(L: any, y0: number, y1: number, step: number): number[][] {\n  const P = L.keel;\n  const n = P.length;\n  // parametrise by cumulative chord length so the near-vertical stem face is handled\n  const s: number[] = [0];\n  for (let i = 1; i < n; i++) s.push(s[i - 1] + Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]));\n  const at = (u: number) => {\n    let i = 0;\n    while (i < n - 2 && u > s[i + 1]) i++;\n    const p0 = P[Math.max(i - 1, 0)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(i + 2, n - 1)];\n    const h = s[i + 1] - s[i], t = Math.min(Math.max((u - s[i]) / h, 0), 1), t2 = t * t, t3 = t2 * t;\n    const s0 = s[Math.max(i - 1, 0)], s3 = s[Math.min(i + 2, n - 1)];\n    const r = [0, 1].map((k) => {\n      const m1 = ((p2[k] - p0[k]) / (s[i + 1] - s0 || 1)) * h;\n      const m2 = ((p3[k] - p1[k]) / (s3 - s[i] || 1)) * h;\n      return (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    });\n    return r;\n  };\n  const total = s[n - 1];\n  const out: number[][] = [];\n  for (let u = 0; u <= total + 1e-6; u += step) {\n    const p = at(Math.min(u, total));\n    if (p[0] >= y0 - 1e-6 && p[0] <= y1 + 1e-6) out.push(p);\n  }\n  const last = at(total);\n  if (out.length && (out[out.length - 1][0] !== last[0] || out[out.length - 1][1] !== last[1]) && last[0] <= y1 + 1e-6) out.push(last);\n  return out;\n}\nfunction run(lines: string = \"\", width: number = 70, depth: number = 30): Assembly {\n  if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\")) throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n  const L = JSON.parse(lines);\n  const fine = keelProfile(L, L.keel[0][0] + 10, L.stem.aftEndY + 150, 25);\n  const prof = fine.filter((_, i) => i % 8 === 0 || i === fine.length - 1);   // a section about every 200 mm\n  const w = width / 2;\n  const sketches = prof.map(([y, zk]) => {\n    const s = stationAt(L, y);\n    const t = Math.max(0, (s.chineZ - s.keelZ) / s.chineB);   // deadrise slope at this station\n    const z0 = zk - 1.5;   // 1.5 mm proud of the frames' V so their keel notches cut cleanly\n    const pts = [[0, z0], [w, z0 + w * t], [w, zk + depth], [-w, zk + depth], [-w, z0 + w * t]];\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n  });\n  return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * The keel batten (keelson) set into the frames' keel notches, lofted along the keel line from the shared\n * Hull Lines table (wired in), from the transom to just past the stem scarf. Its underside is bevelled to the\n * bottom's deadrise at every station so it stays inside the planking.\n */\nfunction stationAt(L, y) {\n    // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n    const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n    const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n        sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n    const st = [tr, ...L.stations];\n    const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n    const n = st.length;\n    if (y <= st[0].y)\n        return st[0];\n    if (y >= st[n - 1].y)\n        return st[n - 1];\n    let i = 0;\n    while (i < n - 2 && y > st[i + 1].y)\n        i++;\n    const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n    const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n    const out = { y };\n    for (const k of keys) {\n        const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n        const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n        out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    }\n    return out;\n}\n// Smooth keel / stem profile through the table's keel points: returns [y, z] samples from y0 to y1.\nfunction keelProfile(L, y0, y1, step) {\n    const P = L.keel;\n    const n = P.length;\n    // parametrise by cumulative chord length so the near-vertical stem face is handled\n    const s = [0];\n    for (let i = 1; i < n; i++)\n        s.push(s[i - 1] + Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]));\n    const at = (u) => {\n        let i = 0;\n        while (i < n - 2 && u > s[i + 1])\n            i++;\n        const p0 = P[Math.max(i - 1, 0)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(i + 2, n - 1)];\n        const h = s[i + 1] - s[i], t = Math.min(Math.max((u - s[i]) / h, 0), 1), t2 = t * t, t3 = t2 * t;\n        const s0 = s[Math.max(i - 1, 0)], s3 = s[Math.min(i + 2, n - 1)];\n        const r = [0, 1].map((k) => {\n            const m1 = ((p2[k] - p0[k]) / (s[i + 1] - s0 || 1)) * h;\n            const m2 = ((p3[k] - p1[k]) / (s3 - s[i] || 1)) * h;\n            return (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n        });\n        return r;\n    };\n    const total = s[n - 1];\n    const out = [];\n    for (let u = 0; u <= total + 1e-6; u += step) {\n        const p = at(Math.min(u, total));\n        if (p[0] >= y0 - 1e-6 && p[0] <= y1 + 1e-6)\n            out.push(p);\n    }\n    const last = at(total);\n    if (out.length && (out[out.length - 1][0] !== last[0] || out[out.length - 1][1] !== last[1]) && last[0] <= y1 + 1e-6)\n        out.push(last);\n    return out;\n}\nfunction run(lines = \"\", width = 70, depth = 30) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines);\n    const fine = keelProfile(L, L.keel[0][0] + 10, L.stem.aftEndY + 150, 25);\n    const prof = fine.filter((_, i) => i % 8 === 0 || i === fine.length - 1); // a section about every 200 mm\n    const w = width / 2;\n    const sketches = prof.map(([y, zk]) => {\n        const s = stationAt(L, y);\n        const t = Math.max(0, (s.chineZ - s.keelZ) / s.chineB); // deadrise slope at this station\n        const z0 = zk - 1.5; // 1.5 mm proud of the frames' V so their keel notches cut cleanly\n        const pts = [[0, z0], [w, z0 + w * t], [w, zk + depth], [-w, zk + depth], [-w, z0 + w * t]];\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n    });\n    return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n"
