                  "ioValue": "{\"camber\":{\"deg\":0,\"p\":[[0,487.7],[200,487.7],[420,520],[750,553.4],[1200,604.3],[1800,690.8],[2400,756.8],[3000,836.8],[3600,801.8],[4000,749.4],[4300,703.1],[4600,490.5],[4930,148.3],[5050,0]],\"t\":[[0,-645.2],[150,-601.2],[240,-574.7],[600,-474.2],[1200,-342],[2180,-210],[3170,-212],[4150,-100],[4450,-75],[4600,-64],[4670,-60],[4900,-60]],\"tr\":[[211.9,-466.8],[300,-820]],\"s\":[[0,14.7,0,1,14.7,-645.2,1,-56.2,-678.7,0,-97.1,-734.3,0,-107.9,-812,0.4,189.9,-816,0,666.4,-822.4,1],[0.048,-1.4,0,1,-1.4,-570,1,-66.8,-638.4,0,-97.7,-718.7,0,-93.9,-812,0.4,203.6,-814.7,0,678.7,-824.6,1],[0.091,0,0,1,0,-522.9,1,-55.2,-604.6,0,-79.7,-693.5,0,-73,-790.3,0.55,224.5,-801.4,0,699.1,-827.9,1],[0.165,0.3,0,1,0.3,-448.7,1,-36.1,-548.4,0,-49.2,-650.4,0,-38.5,-755.1,0.79,256.8,-782.5,0,727.8,-832.2,1],[0.268,0,0,1,0,-342,1,-5.1,-470.5,0,2.3,-598,0,22.2,-725,1,317.1,-767.5,0,787.3,-835.3,1],[0.345,0.8,0,1,0.8,-256.4,1,24.2,-414.6,0,52.2,-572.5,0,84.5,-730,1,380.9,-771.4,0,854.2,-836.6,1],[0.421,-1,0,1,-1,-210,1,46.6,-385,0,94.6,-560,0,143,-735,1,440.5,-775.1,0,914.9,-839.6,1],[0.495,0.9,0,1,0.9,-211,1,67.3,-384,0,134.2,-557,0,201.7,-729.9,1,499,-773.9,0,972.6,-845.5,1],[0.571,-2.2,0,1,-2.2,-212,1,74.8,-382.7,0,151.8,-553.3,0,228.8,-724,1,524.3,-772,0,994.8,-848.4,1],[0.654,0.8,0,1,0.8,-167.5,1,81.6,-342.3,0,162.2,-516.9,0,242.4,-691.4,1,515.9,-753.8,0,959.8,-847.4,1],[0.773,-8.6,0,1,-8.6,-99.8,1,92.2,-270.6,0,190.3,-442.8,0,286.1,-616.3,1,506,-707.6,0,879.1,-840.6,1],[0.818,11.8,0,1,11.8,-87.3,1,99.9,-251.7,0,191.9,-421.7,0,286.9,-595.9,1,496.6,-698.9,0,885.2,-841.2,1],[0.862,49.4,0,1,49.4,-77.2,1,122,-229.1,0,200.1,-392.4,0,284.3,-565.5,1,467.6,-686.2,0,889.2,-841.6,1],[0.902,96.6,0,1,96.6,-68.4,1,146.2,-197.5,0,207.2,-346.2,0,280,-509.4,1,408.6,-635.1,0,795.4,-834.3,1],[0.928,162.1,0,1,162.1,-63.6,1,191.6,-164.9,0,232.1,-286.2,0,284.1,-433.1,1,353.8,-543.4,0,636.1,-793.6,1],[0.953,254.6,0,1,254.6,-60.7,1,261.8,-136.2,0,273.8,-219.3,0,297.2,-320.2,1,311.4,-341.1,0,387.1,-507.5,1]]},\"place\":[-300,820],\"crown\":[[-90,110],[0,105],[300,70],[900,45],[1880,50],[2870,55.5],[3850,50],[4300,15],[4400,0]],\"frames\":[900,1880,2870,3850],\"stem\":{\"aftEndY\":3400,\"moulding\":110,\"siding\":40}}"
                },
                {
                  "name": "kind",
