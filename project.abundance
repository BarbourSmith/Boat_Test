              "ioValue": "{\"camber\":{\"deg\":0,\"p\":[[0,424.8],[150,462.2],[300,505],[500,553.2],[750,606.3],[1050,661.9],[1400,715.3],[1800,760],[2200,789],[2600,796.5],[3000,779.7],[3350,739.2],[3650,677.8],[3900,599.3],[4100,506.2],[4300,399.4],[4500,279.2],[4680,145.9],[4800,0]],\"t\":[[0,-671.1],[150,-610.1],[240,-575.9],[400,-519.5],[600,-456.9],[800,-403.4],[1000,-358.9],[1200,-323.1],[1400,-295.3],[1600,-274.4],[1800,-258.8],[2000,-246.5],[2200,-235.1],[2400,-222.5],[2600,-207],[2800,-187.7],[3000,-165.2],[3200,-140.4],[3400,-114.8],[3600,-89.6],[3800,-65.6],[4000,-43.4],[4150,-28.1],[4250,-18.6],[4330,-11.3],[4380,-6.9],[4412,-4.6],[4600,-4.6]],\"tr\":[[211.9,-466.8],[300,-820]],\"s\":[[0.023,-20.4,0,1,-20.4,-616.1,1,-91,-669.4,0,-130,-736.1,0,-136.8,-820.2,0.36,170.1,-821.2,0,664.4,-823.4,1],[0.051,-8.3,0,1,-8.3,-570.8,1,-74.3,-641.7,0,-106.7,-721.4,0,-104.1,-813.6,0.39,202.9,-814.6,0,697.4,-825.9,1],[0.1,6.2,0,1,6.2,-512.3,1,-49.1,-604.1,0,-71.4,-700.1,0,-59.2,-802.8,0.53,245,-809.1,0,735,-829.1,1],[0.157,16.9,0,1,16.9,-447.3,1,-20.4,-560,0,-29.6,-673,0,-9.6,-787.8,0.8,292.1,-801.7,0,778,-833.4,1],[0.222,22,0,1,22,-374.8,1,13.2,-507.1,0,22.2,-637.6,0,49.3,-766.9,1,348.7,-791.7,0,830.8,-839,1],[0.275,18.5,0,1,18.5,-324.3,1,35.3,-467.5,0,60.8,-609.3,0,94.7,-749.9,1,392.7,-783.7,0,872.8,-843.3,1],[0.321,8.6,0,1,8.6,-288.3,1,46.4,-438.2,0,86.9,-587.8,0,129.8,-737,1,427.7,-777.8,0,908,-846.3,1],[0.364,-4.8,0,1,-4.8,-263.8,1,47.8,-418.8,0,100.9,-573.9,0,154.4,-729.2,1,454.1,-774.3,0,937.1,-848,1],[0.406,-17.4,0,1,-17.4,-246.6,1,45.2,-406.2,0,108.1,-566,0,171.3,-726,1,473.4,-773,0,959.3,-848.6,1],[0.448,-26,0,1,-26,-231,1,44.3,-395.8,0,114.7,-560.6,0,185.2,-725.5,1,487.2,-772.8,0,971.8,-848.7,1],[0.491,-29.1,0,1,-29.1,-212,1,47.9,-382.7,0,124.9,-553.3,0,201.8,-724,1,497.4,-772,0,972.3,-849.1,1],[0.534,-28.7,0,1,-28.7,-186,1,56.7,-362.3,0,141.7,-538.5,0,226.6,-714.5,1,506,-767.7,0,958.7,-851.4,1],[0.579,-21.8,0,1,-21.8,-154,1,72.6,-331.8,0,166.4,-509.7,0,259.7,-687.9,1,512.5,-755.7,0,929.3,-857.2,1],[0.629,1.4,0,1,1.4,-119.7,1,99.9,-290.6,0,198.2,-463,0,296.1,-636.8,1,513.8,-727.9,0,882.4,-861.1,1],[0.665,29.1,0,1,29.1,-97.8,1,125.1,-258.2,0,221.7,-421.8,0,318.7,-588.6,1,509.8,-694.9,0,841.5,-850.8,1],[0.703,63.9,0,1,63.9,-78.3,1,152.8,-224.3,0,243.7,-375.6,0,336.4,-532.2,1,500.6,-650.6,0,794.3,-828,1],[0.744,100.5,0,1,100.5,-61.5,1,179.1,-190.6,0,261.3,-327.4,0,346.9,-471.8,1,485.3,-597.3,0,743.1,-792.5,1],[0.788,134.3,0,1,134.3,-47.3,1,200.7,-157.7,0,272.1,-277.7,0,348.5,-407.6,1,461.9,-533.2,0,683,-740.1,1],[0.83,166,0,1,166,-35.3,1,219.7,-125.6,0,278.8,-225.6,0,343.8,-336.4,1,429.9,-449.8,0,603,-650.1,1],[0.866,195.6,0,1,195.6,-25.7,1,237.4,-97,0,284.3,-177.3,0,337.2,-267.8,1,397.8,-359.6,0,524.7,-535.1,1],[0.894,219.9,0,1,219.9,-18.8,1,251.9,-74.5,0,288.4,-137.9,0,330.3,-210.6,1,370.4,-277.8,0,461.1,-420.7,1],[0.916,239.8,0,1,239.8,-13.4,1,263.4,-55.9,0,290.8,-104.8,0,322.8,-161.5,1,346.2,-203.9,0,407.9,-311.4,1],[0.944,265.4,0,1,265.4,-6.7,1,277.6,-30.9,0,292.1,-59,0,309.5,-91.9,1,323.3,-118.8,0,333.7,-139.1,1]]},\"place\":[-300,820],\"crown\":[[-90,110],[-44,107],[50,100.7],[150,93.9],[250,87],[350,80.3],[470,72.8],[620,64.8],[800,58],[1000,53.8],[1200,52.5],[1430,52.9],[1700,54],[2000,55],[2240,55.5],[2500,55.6],[2800,54.1],[3062,50],[3300,43.3],[3500,35.3],[3700,25.4],[3850,16.9],[3950,10.7],[4030,5.5],[4080,2.2],[4112,0]],\"frames\":[620,1430,2240,3062],\"stem\":{\"aftEndY\":3150,\"moulding\":110,\"siding\":40}}"
