          "interpreterVersion": 1,
          "code": "/**\n * util.Mirror (tristan-huber/util.Mirror) as used in the CamberInterpreter: mirrors the half-hull skin across the\n * XZ plane (its centreline in the camber layout) and flips the mirrored faces so they still face outward. Kept as a\n * copy because the shared molecule's input is saved as a number and the bridge won't wire geometry into it.\n */\nfunction run(assembly: Assembly) {\n  return assembly.onLeafs((leaf: any) => {\n    if (leaf.geometry instanceof replicad.Drawing) {\n      leaf.geometry = leaf.geometry.mirror([1, 0], [0, 0], \"plane\");\n    } else {\n      leaf.geometry = leaf.geometry.mirror(\"XZ\");\n      if (leaf.geometry instanceof replicad.Face) leaf.geometry = leaf.geometry.flipOrientation();\n    }\n    return leaf;\n  });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * util.Mirror (tristan-huber/util.Mirror) as used in the CamberInterpreter: mirrors the half-hull skin across the\n * XZ plane (its centreline in the camber layout) and flips the mirrored faces so they still face outward. Kept as a\n * copy because the shared molecule's input is saved as a number and the bridge won't wire geometry into it.\n */\nfunction run(assembly) {\n    return assembly.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Drawing) {\n            leaf.geometry = leaf.geometry.mirror([1, 0], [0, 0], \"plane\");\n        }\n        else {\n            leaf.geometry = leaf.geometry.mirror(\"XZ\");\n            if (leaf.geometry instanceof replicad.Face)\n                leaf.geometry = leaf.geometry.flipOrientation();\n        }\n        return leaf;\n    });\n}\n"
        },
