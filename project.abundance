              "interpreterVersion": 1,
              "code": "/**\n * Outer outline of one hull frame, drawn from the shared hull lines at this frame's station.\n * Returns the 2D outline in the frame's own plane: X across the boat, Y = height above the baseline (mm).\n * The lightening cutout, thickness, placement and tag are built-in atoms beside this one.\n */\nconst DEFAULT_LINES = `{\"note\":\"Hull lines in mm, to the inside of the planking (the frame outlines). X across (+ starboard), Y forward from the transom's deck-corner line, Z up from the baseline (keel at frame 7). Measured from the reference photos.\",\"transom\":{\"keelY\":-96,\"keelZ\":184,\"rakeDeg\":14,\"chineB\":530,\"chineV\":110,\"sheerB\":645,\"sheerV\":400,\"crown\":32,\"bulge\":60},\"stations\":[{\"name\":\"Frame 8\",\"y\":535,\"keelZ\":60,\"chineB\":600,\"chineZ\":185,\"sheerB\":760,\"sheerZ\":590,\"crown\":45,\"bulge\":20},{\"name\":\"Frame 7\",\"y\":1070,\"keelZ\":0,\"chineB\":591,\"chineZ\":96,\"sheerB\":822,\"sheerZ\":608,\"crown\":55.5,\"bulge\":0},{\"name\":\"Frame 6\",\"y\":1605,\"keelZ\":0,\"chineB\":555,\"chineZ\":118,\"sheerB\":810,\"sheerZ\":630,\"crown\":54,\"bulge\":0},{\"name\":\"Frame 5\",\"y\":2140,\"keelZ\":0,\"chineB\":495,\"chineZ\":145,\"sheerB\":778,\"sheerZ\":655,\"crown\":52,\"bulge\":0},{\"name\":\"Frame 4\",\"y\":2675,\"keelZ\":0,\"chineB\":425,\"chineZ\":176,\"sheerB\":731,\"sheerZ\":680,\"crown\":50,\"bulge\":0},{\"name\":\"Frame 3\",\"y\":3210,\"keelZ\":15,\"chineB\":335,\"chineZ\":228,\"sheerB\":652,\"sheerZ\":712,\"crown\":45,\"bulge\":0},{\"name\":\"Frame 2\",\"y\":3745,\"keelZ\":95,\"chineB\":215,\"chineZ\":318,\"sheerB\":520,\"sheerZ\":758,\"crown\":35,\"bulge\":0},{\"name\":\"Frame 1\",\"y\":4280,\"keelZ\":310,\"chineB\":90,\"chineZ\":480,\"sheerB\":305,\"sheerZ\":822,\"crown\":20,\"bulge\":0},{\"name\":\"Bow\",\"y\":4540,\"keelZ\":600,\"chineB\":6,\"chineZ\":670,\"sheerB\":14,\"sheerZ\":870,\"crown\":1,\"bulge\":0}],\"keel\":[[-96,184],[535,60],[1070,0],[3000,0],[3210,15],[3500,45],[3745,95],[4000,175],[4280,310],[4450,450],[4540,600],[4590,740],[4610,880]],\"stem\":{\"aftEndY\":3300,\"moulding\":110,\"siding\":40},\"keelBatten\":{\"width\":136,\"depth\":20},\"frameBand\":68,\"frameBottomBand\":56,\"frameCornerRadius\":70}`;\n// ---- shared hull-lines helpers (same in every hull code atom) ----\n// Use the wired Hull Lines table when there is one, else the copy above.\nfunction linesOrDefault(lines: string): string {\n  return lines && lines.trim().startsWith(\"{\") ? lines : DEFAULT_LINES;\n}\n// Interpolates the station table smoothly (Hermite / Catmull-Rom) at any Y.\nfunction stationAt(L: any, y: number): any {\n  // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n  const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n  const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n    sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n  const st = [tr, ...L.stations];\n  const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n  const n = st.length;\n  if (y <= st[0].y) return st[0];\n  if (y >= st[n - 1].y) return st[n - 1];\n  let i = 0;\n  while (i < n - 2 && y > st[i + 1].y) i++;\n  const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n  const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n  const out: any = { y };\n  for (const k of keys) {\n    const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n    const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n    out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n  }\n  return out;\n}\n// Closed section outline (x across, z up): keel -> starboard chine -> side -> sheer -> deck crown -> port side -> back.\n// Hard chine; the side bulges outward by `bulge` (tumblehome aft); the deck is a parabolic crown.\nfunction sectionPoints(s: any, n: number): number[][] {\n  const half: number[][] = [[0, s.keelZ], [s.chineB, s.chineZ]];\n  const dx = s.sheerB - s.chineB, dz = s.sheerZ - s.chineZ, len = Math.hypot(dx, dz) || 1;\n  const cx = (s.chineB + s.sheerB) / 2 + (s.bulge * dz) / len;\n  const cz = (s.chineZ + s.sheerZ) / 2 - (s.bulge * dx) / len;\n  for (let i = 1; i <= n; i++) {\n    const t = i / n, a = (1 - t) * (1 - t), b = 2 * (1 - t) * t, c = t * t;\n    half.push([a * s.chineB + b * cx + c * s.sheerB, a * s.chineZ + b * cz + c * s.sheerZ]);\n  }\n  for (let i = 1; i <= n; i++) {\n    const x = s.sheerB * (1 - i / n);\n    half.push([x, s.sheerZ + s.crown * (1 - (x / s.sheerB) ** 2)]);\n  }\n  const port = half.slice(1, half.length - 1).reverse().map((p) => [-p[0], p[1]]);\n  return [...half, ...port];\n}\n\nfunction run(lines: string = \"\", stationY: number = 1070): Assembly {\n  const L = JSON.parse(linesOrDefault(lines));\n  const pts = sectionPoints(stationAt(L, stationY), 12);\n  let pen = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n  return new Assembly({ geometry: pen.close() });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Outer outline of one hull frame, drawn from the shared hull lines at this frame's station.\n * Returns the 2D outline in the frame's own plane: X across the boat, Y = height above the baseline (mm).\n * The lightening cutout, thickness, placement and tag are built-in atoms beside this one.\n */\nconst DEFAULT_LINES = `{\"note\":\"Hull lines in mm, to the inside of the planking (the frame outlines). X across (+ starboard), Y forward from the transom's deck-corner line, Z up from the baseline (keel at frame 7). Measured from the reference photos.\",\"transom\":{\"keelY\":-96,\"keelZ\":184,\"rakeDeg\":14,\"chineB\":530,\"chineV\":110,\"sheerB\":645,\"sheerV\":400,\"crown\":32,\"bulge\":60},\"stations\":[{\"name\":\"Frame 8\",\"y\":535,\"keelZ\":60,\"chineB\":600,\"chineZ\":185,\"sheerB\":760,\"sheerZ\":590,\"crown\":45,\"bulge\":20},{\"name\":\"Frame 7\",\"y\":1070,\"keelZ\":0,\"chineB\":591,\"chineZ\":96,\"sheerB\":822,\"sheerZ\":608,\"crown\":55.5,\"bulge\":0},{\"name\":\"Frame 6\",\"y\":1605,\"keelZ\":0,\"chineB\":555,\"chineZ\":118,\"sheerB\":810,\"sheerZ\":630,\"crown\":54,\"bulge\":0},{\"name\":\"Frame 5\",\"y\":2140,\"keelZ\":0,\"chineB\":495,\"chineZ\":145,\"sheerB\":778,\"sheerZ\":655,\"crown\":52,\"bulge\":0},{\"name\":\"Frame 4\",\"y\":2675,\"keelZ\":0,\"chineB\":425,\"chineZ\":176,\"sheerB\":731,\"sheerZ\":680,\"crown\":50,\"bulge\":0},{\"name\":\"Frame 3\",\"y\":3210,\"keelZ\":15,\"chineB\":335,\"chineZ\":228,\"sheerB\":652,\"sheerZ\":712,\"crown\":45,\"bulge\":0},{\"name\":\"Frame 2\",\"y\":3745,\"keelZ\":95,\"chineB\":215,\"chineZ\":318,\"sheerB\":520,\"sheerZ\":758,\"crown\":35,\"bulge\":0},{\"name\":\"Frame 1\",\"y\":4280,\"keelZ\":310,\"chineB\":90,\"chineZ\":480,\"sheerB\":305,\"sheerZ\":822,\"crown\":20,\"bulge\":0},{\"name\":\"Bow\",\"y\":4540,\"keelZ\":600,\"chineB\":6,\"chineZ\":670,\"sheerB\":14,\"sheerZ\":870,\"crown\":1,\"bulge\":0}],\"keel\":[[-96,184],[535,60],[1070,0],[3000,0],[3210,15],[3500,45],[3745,95],[4000,175],[4280,310],[4450,450],[4540,600],[4590,740],[4610,880]],\"stem\":{\"aftEndY\":3300,\"moulding\":110,\"siding\":40},\"keelBatten\":{\"width\":136,\"depth\":20},\"frameBand\":68,\"frameBottomBand\":56,\"frameCornerRadius\":70}`;\n// ---- shared hull-lines helpers (same in every hull code atom) ----\n// Use the wired Hull Lines table when there is one, else the copy above.\nfunction linesOrDefault(lines) {\n    return lines && lines.trim().startsWith(\"{\") ? lines : DEFAULT_LINES;\n}\n// Interpolates the station table smoothly (Hermite / Catmull-Rom) at any Y.\nfunction stationAt(L, y) {\n    // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n    const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n    const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n        sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n    const st = [tr, ...L.stations];\n    const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n    const n = st.length;\n    if (y <= st[0].y)\n        return st[0];\n    if (y >= st[n - 1].y)\n        return st[n - 1];\n    let i = 0;\n    while (i < n - 2 && y > st[i + 1].y)\n        i++;\n    const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n    const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n    const out = { y };\n    for (const k of keys) {\n        const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n        const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n        out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    }\n    return out;\n}\n// Closed section outline (x across, z up): keel -> starboard chine -> side -> sheer -> deck crown -> port side -> back.\n// Hard chine; the side bulges outward by `bulge` (tumblehome aft); the deck is a parabolic crown.\nfunction sectionPoints(s, n) {\n    const half = [[0, s.keelZ], [s.chineB, s.chineZ]];\n    const dx = s.sheerB - s.chineB, dz = s.sheerZ - s.chineZ, len = Math.hypot(dx, dz) || 1;\n    const cx = (s.chineB + s.sheerB) / 2 + (s.bulge * dz) / len;\n    const cz = (s.chineZ + s.sheerZ) / 2 - (s.bulge * dx) / len;\n    for (let i = 1; i <= n; i++) {\n        const t = i / n, a = (1 - t) * (1 - t), b = 2 * (1 - t) * t, c = t * t;\n        half.push([a * s.chineB + b * cx + c * s.sheerB, a * s.chineZ + b * cz + c * s.sheerZ]);\n    }\n    for (let i = 1; i <= n; i++) {\n        const x = s.sheerB * (1 - i / n);\n        half.push([x, s.sheerZ + s.crown * (1 - (x / s.sheerB) ** 2)]);\n    }\n    const port = half.slice(1, half.length - 1).reverse().map((p) => [-p[0], p[1]]);\n    return [...half, ...port];\n}\nfunction run(lines = \"\", stationY = 1070) {\n    const L = JSON.parse(linesOrDefault(lines));\n    const pts = sectionPoints(stationAt(L, stationY), 12);\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        pen = pen.lineTo(pts[i]);\n    return new Assembly({ geometry: pen.close() });\n}\n"
