              "compiledCode": "\"use strict\";\n/**\n * Outline of one frame, cut from the camber hull (the Hull Lines table) at stationY: the hull section inside the\n * planking (V bottom, chine, topsides) with the crowned deck beam across the top. Drawn with X across and Y up\n * (the model's Z), so the frame molecule extrudes it, stands it up with Rotate x 90 and moves it to stationY.\n */\nfunction run(lines = \"\", stationY = 2870) {\n    const H = hullOf(lines);\n    const s = hullSection(H, stationY);\n    if (s.pts.length < 3)\n        throw new Error(`The hull has no section at Y = ${stationY}.`);\n    const half = s.pts.slice().reverse(); // keel -> sheer\n    const sheer = half[half.length - 1], crown = hullCrown(H, stationY), n = 12;\n    for (let i = 1; i <= n; i++) {\n        const x = sheer[0] * (1 - i / n);\n        half.push([x, sheer[1] + crown * (1 - (x / sheer[0]) ** 2)]);\n    }\n    const port = half.slice(1, half.length - 1).reverse().map((p) => [-p[0], p[1]]);\n    const pts = [...half, ...port];\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        if (Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]) > 0.05)\n            pen = pen.lineTo(pts[i]);\n    return new Assembly({ geometry: pen.close() });\n}\n// ---- camber hull helpers (port of github.com/electricshipwrights/camber, document v2); the same in every hull atom ----\n// ---- camber hull evaluator (port of electricshipwrights/camber, document v2), shared by the hull code atoms ----\n// hullOf(lines) reads the Hull Lines table. World: X across (+ starboard), Y forward, Z up (mm).\nfunction hullOf(lines) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines), c = L.camber;\n    const clamp = (x, a, b) => Math.min(b, Math.max(a, x));\n    // sheer plan: clamped cubic B-spline over u ∈ [0,1], with its e