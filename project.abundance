, 55.6], [2800, 54.1], [3062, 50], [3300, 43.3], [3500, 35.3], [3700, 25.4], [3850, 16.9], [3950, 10.7], [4030, 5.5], [4080, 2.2], [4112, 0]];\n// frame stations (Y of each frame's centre plane), the stem, read by the frames, keel, stem and battens\nconst PARTS = { frames: [620, 1430, 2240, 3062], stem: { aftEndY: 3150, moulding: 110, siding: 40 } };\nfunction run() {\n    const c = CAMBER, f = (v) => Math.round(v * 100) / 100;\n    return JSON.stringify({\n        camber: {\n            deg: c.deckTrimDeg,\n            p: c.sheerPlan.map((q) => [f(q.x), f(q.y)]),\n            t: c.sheerTrim.map((q) => [f(q.x), f(q.z)]),\n            tr: c.transom.map((q) => [f(q.x), f(q.z)]),\n            s: c.stations.map((s) => [s.u, ...s.points.flatMap((q) => [f(q.n), f(q.z), q.k])]),\n        },\n        place: PLACE, crown: CROWN, ...PARTS,\n    });\n}\n"
