x - width / 2, z - thickness], [x + width / 2, z - thickness], [x + width / 2, z], [x - width / 2, z]];\n    }\n    if (side < 0) pts = pts.map((p) => [-p[0], p[1]]).reverse();\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n  });\n  return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * One longitudinal batten lofted along the inside of the hull from the shared Hull Lines table (wired in):\n * kind \"deck\" (deck batten at `fraction` of the deck half-breadth), \"sheer\" (sheer clamp in the frames' top corner),\n * \"chine\" (chine log in the chine corner) or \"bottom\" (bottom batten at `fraction` from keel to chine).\n * side = 1 starboard, -1 port. It overlaps the frames so the Assembly cuts their notches, as on the CNC-cut frames.\n */\nfunction stationAt(L, y) {\n    // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n    const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n    const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n        sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n    const st = [tr, ...L.stations];\n    const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n    const n = st.length;\n    if (y <= st[0].y)\n        return st[0];\n    if (y >= st[n - 1].y)\n        return st[n - 1];\n    let i = 0;\n    while (i < n - 2 && y > st[i + 1].y)\n        i++;\n    const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n    const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n    const out = { y };\n    for (const k of keys) {\n        const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n        const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n        out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    }\n    return out;\n}\nfunction run(lines = \"\", kind = \"deck\", fraction = 0.5, side = 1, width = 30, thickness = 13, startY = 0, endY = 4400) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines);\n    // sections on a regular grid plus exactly at every frame station, so the notches the frames get are exact\n    const n = Math.max(8, Math.round((endY - startY) / 220));\n    const frames = L.stations.map((st) => st.y).filter((y) => y > startY + 40 && y < endY - 40);\n    const ys = [startY, endY, ...frames];\n    for (let i = 1; i < n; i++) {\n        const y = startY + ((endY - startY) * i) / n;\n        if (frames.every((f) => Math.abs(f - y) > 60))\n            ys.push(y);\n    }\n    ys.sort((a, b) => a - b);\n    const sketches = ys.map((y) => {\n        const s = stationAt(L, y);\n        let pts;\n        // each batten stands 2.5-3 mm proud of the frame edge it sits on, so the Assembly cuts clean notches (no slivers)\n        if (kind === \"sheer\") {\n            const slope = (s.sheerB - s.chineB) / (s.sheerZ - s.chineZ), xo = s.sheerB + 2.5;\n            pts = [[xo - thickness * slope - width, s.sheerZ - thickness], [xo - thickness * slope, s.sheerZ - thickness], [xo, s.sheerZ + 3], [xo - width, s.sheerZ + 3]];\n        }\n        else if (kind === \"chine\") {\n            pts = [[s.chineB - width, s.chineZ - 5], [s.chineB + 5, s.chineZ - 5], [s.chineB + 5, s.chineZ + thickness], [s.chineB - width, s.chineZ + thickness]];\n        }\n        else if (kind === \"bottom\") {\n            // lies on the bottom panel's inside face, square to it\n            const dx = s.chineB, dz = s.chineZ - s.keelZ, l = Math.hypot(dx, dz), ux = dx / l, uz = dz / l;\n            const cx = fraction * s.chineB + 2.5 * uz, cz = s.keelZ + fraction * dz - 2.5 * ux;\n            const a = [cx - (ux * width) / 2, cz - (uz * width) / 2], b = [cx + (ux * width) / 2, cz + (uz * width) / 2];\n            pts = [a, b, [b[0] - uz * thickness, b[1] + ux * thickness], [a[0] - uz * thickness, a[1] + ux * thickness]];\n        }\n        else {\n            const x = fraction * s.sheerB, z = s.sheerZ + s.crown * (1 - fraction * fraction) + 3;\n            pts = [[x - width / 2, z - thickness], [x + width / 2, z - thickness], [x + width / 2, z], [x - width / 2, z]];\n        }\n        if (side < 0)\n            pts = pts.map((p) => [-p[0], p[1]]).reverse();\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n    });\n    return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n"
