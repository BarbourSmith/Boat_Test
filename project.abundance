          "ioValues": [
            {
              "name": "lines",
              "ioValue": "{\"note\":\"Hull lines in mm, to the inside of the planking (the frame outlines). Measured from the reference photos.\",\"transom\":{\"keelY\":-96,\"keelZ\":184,\"rakeDeg\":14,\"chineB\":530,\"chineV\":110,\"sheerB\":645,\"sheerV\":400,\"crown\":32,\"bulge\":60},\"stations\":[{\"name\":\"Frame 8\",\"y\":535,\"keelZ\":60,\"chineB\":600,\"chineZ\":185,\"sheerB\":760,\"sheerZ\":590,\"crown\":45,\"bulge\":20},{\"name\":\"Frame 7\",\"y\":1070,\"keelZ\":0,\"chineB\":591,\"chineZ\":96,\"sheerB\":822,\"sheerZ\":608,\"crown\":55.5,\"bulge\":0},{\"name\":\"Frame 6\",\"y\":1605,\"keelZ\":0,\"chineB\":555,\"chineZ\":118,\"sheerB\":810,\"sheerZ\":630,\"crown\":54,\"bulge\":0},{\"name\":\"Frame 5\",\"y\":2140,\"keelZ\":0,\"chineB\":495,\"chineZ\":145,\"sheerB\":778,\"sheerZ\":655,\"crown\":52,\"bulge\":0},{\"name\":\"Frame 4\",\"y\":2675,\"keelZ\":0,\"chineB\":425,\"chineZ\":176,\"sheerB\":731,\"sheerZ\":680,\"crown\":50,\"bulge\":0},{\"name\":\"Frame 3\",\"y\":3210,\"keelZ\":15,\"chineB\":335,\"chineZ\":228,\"sheerB\":652,\"sheerZ\":712,\"crown\":45,\"bulge\":0},{\"name\":\"Frame 2\",\"y\":3745,\"keelZ\":95,\"chineB\":215,\"chineZ\":318,\"sheerB\":520,\"sheerZ\":758,\"crown\":35,\"bulge\":0},{\"name\":\"Frame 1\",\"y\":4280,\"keelZ\":310,\"chineB\":90,\"chineZ\":480,\"sheerB\":305,\"sheerZ\":822,\"crown\":20,\"bulge\":0},{\"name\":\"Bow\",\"y\":4540,\"keelZ\":600,\"chineB\":6,\"chineZ\":670,\"sheerB\":14,\"sheerZ\":870,\"crown\":1,\"bulge\":0}],\"keel\":[[-96,184],[200,118],[535,60],[800,20],[1070,0],[1600,0],[2200,0],[2700,0],[3000,0],[3210,15],[3500,45],[3745,95],[4000,175],[4280,310],[4450,450],[4540,600],[4590,740],[4610,880]],\"stem\":{\"aftEndY\":3300,\"moulding\":110,\"siding\":40},\"keelBatten\":{\"width\":136,\"depth\":20},\"frameBand\":68,\"frameBottomBand\":56,\"frameCornerRadius\":70}"
            },
            {
              "name": "planking",
              "ioValue": 9
            },
            {
              "name": "deck",
              "ioValue": false
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * The hull planking (bottom and topsides), lofted through the shared Hull Lines table (wired in): the raked\n * transom and sections every half frame space to the bow, offset outward by the planking thickness, minus the\n * moulded hull inside it. With deck off, everything above the sheer is cut away so the frames show from above,\n * as in the photos.\n */\nfunction stationAt(L: any, y: number): any {\n  // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n  const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n  const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n    sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n  const st = [tr, ...L.stations];\n  const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n  const n = st.length;\n  if (y <= st[0].y) return st[0];\n  if (y >= st[n - 1].y) return st[n - 1];\n  let i = 0;\n  while (i < n - 2 && y > st[i + 1].y) i++;\n  const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n  const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n  const out: any = { y };\n  for (const k of keys) {\n    const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n    const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n    out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n  }\n  return out;\n}\n// keel -> starboard chine -> side (bulged quadratic) -> sheer -> parabolic deck crown -> mirrored port side\nfunction sectionPoints(s: any, n: number): number[][] {\n  const half: number[][] = [[0, s.keelZ], [s.chineB, s.chineZ]];\n  const dx = s.sheerB - s.chineB, dz = s.sheerZ - s.chineZ, len = Math.hypot(dx, dz) || 1;\n  const cx = (s.chineB + s.sheerB) / 2 + (s.bulge * dz) / len;\n  const cz = (s.chineZ + s.sheerZ) / 2 - (s.bulge * dx) / len;\n  for (let i = 1; i <= n; i++) {\n    const t = i / n, a = (1 - t) * (1 - t), b = 2 * (1 - t) * t, c = t * t;\n    half.push([a * s.chineB + b * cx + c * s.sheerB, a * s.chineZ + b * cz + c * s.sheerZ]);\n  }\n  for (let i = 1; i <= n; i++) {\n    const x = s.sheerB * (1 - i / n);\n    half.push([x, s.sheerZ + s.crown * (1 - (x / s.sheerB) ** 2)]);\n  }\n  const port = half.slice(1, half.length - 1).reverse().map((p) => [-p[0], p[1]]);\n  return [...half, ...port];\n}\nfunction offsetLoop(pts: number[][], d: number): number[][] {\n  // offset a closed counter-clockwise polyline outward by d (outward is right of travel)\n  const n = pts.length, out: number[][] = [];\n  for (let i = 0; i < n; i++) {\n    const a = pts[(i - 1 + n) % n], b = pts[i], c = pts[(i + 1) % n];\n    let n1 = [b[1] - a[1], -(b[0] - a[0])], n2 = [c[1] - b[1], -(c[0] - b[0])];\n    const l1 = Math.hypot(n1[0], n1[1]) || 1, l2 = Math.hypot(n2[0], n2[1]) || 1;\n    n1 = [n1[0] / l1, n1[1] / l1]; n2 = [n2[0] / l2, n2[1] / l2];\n    let m = [n1[0] + n2[0], n1[1] + n2[1]];\n    const ml = Math.hypot(m[0], m[1]) || 1; m = [m[0] / ml, m[1] / ml];\n    const k = d / Math.max(0.35, m[0] * n1[0] + m[1] * n1[1]);\n    out.push([b[0] + m[0] * k, b[1] + m[1] * k]);\n  }\n  return out;\n}\nfunction drawLoop(pts: number[][]): any {\n  let pen = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n  return pen.close();\n}\n// One loft through the transom plane and the stations; `make` turns a section into the loop to loft.\nfunction loftHull(L: any, make: (s: any) => number[][]): any {\n  const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n  const plane = new replicad.Plane([0, T.keelY, T.keelZ], [1, 0, 0], [0, -Math.cos(r), Math.sin(r)]);\n  const sketches: any[] = [drawLoop(make({ keelZ: 0, chineB: T.chineB, chineZ: T.chineV, sheerB: T.sheerB, sheerZ: T.sheerV, crown: T.crown, bulge: T.bulge })).sketchOnPlane(plane)];\n  const st = L.stations, ys: number[] = [st[0].y * 0.25, st[0].y * 0.6];\n  for (let i = 0; i < st.length; i++) {\n    ys.push(st[i].y);\n    if (i < st.length - 2) ys.push((st[i].y + st[i + 1].y) / 2);\n  }\n  for (const y of ys) sketches.push(drawLoop(make(stationAt(L, y))).sketchOnPlane(\"XZ\", [0, y, 0]));\n  return sketches[0].loftWith(sketches.slice(1), { ruled: false });\n}\nfunction run(lines: string = \"\", planking: number = 9, deck: boolean = false): Assembly {\n  if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\")) throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n  const L = JSON.parse(lines);\n  let skin = loftHull(L, (s) => offsetLoop(sectionPoints(s, 8), planking)).cut(loftHull(L, (s) => sectionPoints(s, 8)));\n  if (!deck) {\n    // a block from just below the sheer upward at every section removes the deck planking; cutting 3 mm under\n    // the sheer keeps the cut clear of the side/deck corner so it leaves no hairline slivers\n    const w = (s: any) => s.sheerB + 2 * planking + 60;\n    skin = skin.cut(loftHull(L, (s) => [[-w(s), s.sheerZ - 3], [w(s), s.sheerZ - 3], [w(s), s.sheerZ + 600], [-w(s), s.sheerZ + 600]]));\n  }\n  return new Assembly({ geometry: skin, color: \"#B5651D\" });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * The hull planking (bottom and topsides), lofted through the shared Hull Lines table (wired in): the raked\n * transom and sections every half frame space to the bow, offset outward by the planking thickness, minus the\n * moulded hull inside it. With deck off, everything above the sheer is cut away so the frames show from above,\n * as in the photos.\n */\nfunction stationAt(L, y) {\n    // the raked transom joins the table as a vertical pseudo-station at its mid-height, so the run aft stays fair\n    const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n    const tr = { y: T.keelY + (T.sheerV / 2) * Math.sin(r), keelZ: T.keelZ, chineB: T.chineB, chineZ: T.keelZ + T.chineV * Math.cos(r),\n        sheerB: T.sheerB, sheerZ: T.keelZ + T.sheerV * Math.cos(r), crown: T.crown * Math.cos(r), bulge: T.bulge };\n    const st = [tr, ...L.stations];\n    const keys = [\"keelZ\", \"chineB\", \"chineZ\", \"sheerB\", \"sheerZ\", \"crown\", \"bulge\"];\n    const n = st.length;\n    if (y <= st[0].y)\n        return st[0];\n    if (y >= st[n - 1].y)\n        return st[n - 1];\n    let i = 0;\n    while (i < n - 2 && y > st[i + 1].y)\n        i++;\n    const p0 = st[Math.max(i - 1, 0)], p1 = st[i], p2 = st[i + 1], p3 = st[Math.min(i + 2, n - 1)];\n    const h = p2.y - p1.y, t = (y - p1.y) / h, t2 = t * t, t3 = t2 * t;\n    const out = { y };\n    for (const k of keys) {\n        const m1 = ((p2[k] - p0[k]) / (p2.y - p0.y || 1)) * h;\n        const m2 = ((p3[k] - p1[k]) / (p3.y - p1.y || 1)) * h;\n        out[k] = (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    }\n    return out;\n}\n// keel -> starboard chine -> side (bulged quadratic) -> sheer -> parabolic deck crown -> mirrored port side\nfunction sectionPoints(s, n) {\n    const half = [[0, s.keelZ], [s.chineB, s.chineZ]];\n    const dx = s.sheerB - s.chineB, dz = s.sheerZ - s.chineZ, len = Math.hypot(dx, dz) || 1;\n    const cx = (s.chineB + s.sheerB) / 2 + (s.bulge * dz) / len;\n    const cz = (s.chineZ + s.sheerZ) / 2 - (s.bulge * dx) / len;\n    for (let i = 1; i <= n; i++) {\n        const t = i / n, a = (1 - t) * (1 - t), b = 2 * (1 - t) * t, c = t * t;\n        half.push([a * s.chineB + b * cx + c * s.sheerB, a * s.chineZ + b * cz + c * s.sheerZ]);\n    }\n    for (let i = 1; i <= n; i++) {\n        const x = s.sheerB * (1 - i / n);\n        half.push([x, s.sheerZ + s.crown * (1 - (x / s.sheerB) ** 2)]);\n    }\n    const port = half.slice(1, half.length - 1).reverse().map((p) => [-p[0], p[1]]);\n    return [...half, ...port];\n}\nfunction offsetLoop(pts, d) {\n    // offset a closed counter-clockwise polyline outward by d (outward is right of travel)\n    const n = pts.length, out = [];\n    for (let i = 0; i < n; i++) {\n        const a = pts[(i - 1 + n) % n], b = pts[i], c = pts[(i + 1) % n];\n        let n1 = [b[1] - a[1], -(b[0] - a[0])], n2 = [c[1] - b[1], -(c[0] - b[0])];\n        const l1 = Math.hypot(n1[0], n1[1]) || 1, l2 = Math.hypot(n2[0], n2[1]) || 1;\n        n1 = [n1[0] / l1, n1[1] / l1];\n        n2 = [n2[0] / l2, n2[1] / l2];\n        let m = [n1[0] + n2[0], n1[1] + n2[1]];\n        const ml = Math.hypot(m[0], m[1]) || 1;\n        m = [m[0] / ml, m[1] / ml];\n        const k = d / Math.max(0.35, m[0] * n1[0] + m[1] * n1[1]);\n        out.push([b[0] + m[0] * k, b[1] + m[1] * k]);\n    }\n    return out;\n}\nfunction drawLoop(pts) {\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        pen = pen.lineTo(pts[i]);\n    return pen.close();\n}\n// One loft through the transom plane and the stations; `make` turns a section into the loop to loft.\nfunction loftHull(L, make) {\n    const T = L.transom, r = (T.rakeDeg * Math.PI) / 180;\n    const plane = new replicad.Plane([0, T.keelY, T.keelZ], [1, 0, 0], [0, -Math.cos(r), Math.sin(r)]);\n    const sketches = [drawLoop(make({ keelZ: 0, chineB: T.chineB, chineZ: T.chineV, sheerB: T.sheerB, sheerZ: T.sheerV, crown: T.crown, bulge: T.bulge })).sketchOnPlane(plane)];\n    const st = L.stations, ys = [st[0].y * 0.25, st[0].y * 0.6];\n    for (let i = 0; i < st.length; i++) {\n        ys.push(st[i].y);\n        if (i < st.length - 2)\n            ys.push((st[i].y + st[i + 1].y) / 2);\n    }\n    for (const y of ys)\n        sketches.push(drawLoop(make(stationAt(L, y))).sketchOnPlane(\"XZ\", [0, y, 0]));\n    return sketches[0].loftWith(sketches.slice(1), { ruled: false });\n}\nfunction run(lines = \"\", planking = 9, deck = false) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines);\n    let skin = loftHull(L, (s) => offsetLoop(sectionPoints(s, 8), planking)).cut(loftHull(L, (s) => sectionPoints(s, 8)));\n    if (!deck) {\n        // a block from just below the sheer upward at every section removes the deck planking; cutting 3 mm under\n        // the sheer keeps the cut clear of the side/deck corner so it leaves no hairline slivers\n        const w = (s) => s.sheerB + 2 * planking + 60;\n        skin = skin.cut(loftHull(L, (s) => [[-w(s), s.sheerZ - 3], [w(s), s.sheerZ - 3], [w(s), s.sheerZ + 600], [-w(s), s.sheerZ + 600]]));\n    }\n    return new Assembly({ geometry: skin, color: \"#B5651D\" });\n}\n"
        },
