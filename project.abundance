,-687.9,1,512.5,-755.7,0,929.3,-857.2,1],[0.629,1.4,0,1,1.4,-119.7,1,99.9,-290.6,0,198.2,-463,0,296.1,-636.8,1,513.8,-727.9,0,882.4,-861.1,1],[0.665,29.1,0,1,29.1,-97.8,1,125.1,-258.2,0,221.7,-421.8,0,318.7,-588.6,1,509.8,-694.9,0,841.5,-850.8,1],[0.703,63.9,0,1,63.9,-78.3,1,152.8,-224.3,0,243.7,-375.6,0,336.4,-532.2,1,500.6,-650.6,0,794.3,-828,1],[0.744,100.5,0,1,100.5,-61.5,1,179.1,-190.6,0,261.3,-327.4,0,346.9,-471.8,1,485.3,-597.3,0,743.1,-792.5,1],[0.788,134.3,0,1,134.3,-47.3,1,200.7,-157.7,0,272.1,-277.7,0,348.5,-407.6,1,461.9,-533.2,0,683,-740.1,1],[0.83,166,0,1,166,-35.3,1,219.7,-125.6,0,278.8,-225.6,0,343.8,-336.4,1,429.9,-449.8,0,603,-650.1,1],[0.866,195.6,0,1,195.6,-25.7,1,237.4,-97,0,284.3,-177.3,0,337.2,-267.8,1,397.8,-359.6,0,524.7,-535.1,1],[0.894,219.9,0,1,219.9,-18.8,1,251.9,-74.5,0,288.4,-137.9,0,330.3,-210.6,1,370.4,-277.8,0,461.1,-420.7,1],[0.916,239.8,0,1,239.8,-13.4,1,263.4,-55.9,0,290.8,-104.8,0,322.8,-161.5,1,346.2,-203.9,0,407.9,-311.4,1],[0.944,265.4,0,1,265.4,-6.7,1,277.6,-30.9,0,292.1,-59,0,309.5,-91.9,1,323.3,-118.8,0,333.7,-139.1,1]]},\"place\":[-300,820],\"crown\":[[-90,110],[-44,107],[50,100.7],[150,93.9],[250,87],[350,80.3],[470,72.8],[620,64.8],[800,58],[1000,53.8],[1200,52.5],[1430,52.9],[1700,54],[2000,55],[2240,55.5],[2500,55.6],[2800,54.1],[3062,50],[3300,43.3],[3500,35.3],[3700,25.4],[3850,16.9],[3950,10.7],[4030,5.5],[4080,2.2],[4112,0]],\"frames\":[620,1430,2240,3062],\"stem\":{\"aftEndY\":3150,\"moulding\":110,\"siding\":40}}"
