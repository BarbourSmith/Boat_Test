      "code": "/**\n * The boat's hull, as a camber hull document (github.com/electricshipwrights/camber, format version 2, mm), plus\n * the few numbers the hull parts need besides the hull surface. Every hull Code atom reads this table: the skin\n * sweeps the camber surface, and the frames, transom, keel, stem and battens are cut from the same surface.\n *\n * To reshape the hull, edit CAMBER here, or paste a document exported from the camber editor\n * (https://risingtideresearch.github.io/camber/) over it. It was fitted to the reference photos, read with the boat\n * upside down on its building jig: four frames about 985 mm apart (frame 3 is the one cut on the Maslow, #4 the\n * narrow one forward), and a barrel-back runabout stern: a low raked transom (top aft) with a flat bottom and sides\n * that tumble home to the deck, the deck sweeping down to it. Overall scale and heights are photo estimates.\n *\n * Camber's frame: x runs aft→forward, y is the half-breadth, z is up from a flat deck datum (the hull hangs below\n * it). PLACE puts camber's origin (x 0, z 0) at world (Y, Z); world X is camber's y. Forward of frame 4 the sheer\n * plan runs on past the stem as construction geometry.\n */\nconst CAMBER = {\n  \"version\": 2,\n  \"name\": \"Boat_Test runabout\",\n  \"unit\": \"mm\",\n  \"waterline\": 0,\n  \"deckTrimDeg\": 0,\n  \"sheerPlan\": [{ \"x\": 0, \"y\": 487.7 }, { \"x\": 200, \"y\": 487.7 }, { \"x\": 420, \"y\": 520 }, { \"x\": 750, \"y\": 553.4 }, { \"x\": 1200, \"y\": 604.3 }, { \"x\": 1800, \"y\": 690.8 }, { \"x\": 2400, \"y\": 756.8 }, { \"x\": 3000, \"y\": 836.8 }, { \"x\": 3600, \"y\": 801.8 }, { \"x\": 4000, \"y\": 749.4 }, { \"x\": 4300, \"y\": 703.1 }, { \"x\": 4600, \"y\": 490.5 }, { \"x\": 4930, \"y\": 148.3 }, { \"x\": 5050, \"y\": 0 }],\n  \"sheerTrim\": [{ \"x\": 0, \"z\": -645.2, \"k\": 0 }, { \"x\": 150, \"z\": -601.2, \"k\": 0 }, { \"x\": 240, \"z\": -574.7, \"k\": 0 }, { \"x\": 600, \"z\": -474.2, \"k\": 0 }, { \"x\": 1200, \"z\": -342, \"k\": 0 }, { \"x\": 2180, \"z\": -210, \"k\": 0 }, { \"x\": 3170, \"z\": -212, \"k\": 0 }, { \"x\": 4150, \"z\": -100, \"k\": 0 }, { \"x\": 4450, \"z\": -75, \"k\": 0 }, { \"x\": 4600, \"z\": -64, \"k\": 0 }, { \"x\": 4670, \"z\": -60, \"k\": 0 }, { \"x\": 4900, \"z\": -60, \"k\": 0 }],\n  \"transom\": [{ \"x\": 211.9, \"z\": -466.8 }, { \"x\": 300, \"z\": -820 }],\n  \"stations\": [\n    { \"u\": 0, \"keelK\": 0, \"points\": [{ \"n\": 14.7, \"z\": 0, \"k\": 1 }, { \"n\": 14.7, \"z\": -645.2, \"k\": 1 }, { \"n\": -56.2, \"z\": -678.7, \"k\": 0 }, { \"n\": -97.1, \"z\": -734.3, \"k\": 0 }, { \"n\": -107.9, \"z\": -812, \"k\": 0.4 }, { \"n\": 189.9, \"z\": -816, \"k\": 0 }, { \"n\": 666.4, \"z\": -822.4, \"k\": 1 }] },\n    { \"u\": 0.048, \"keelK\": 0, \"points\": [{ \"n\": -1.4, \"z\": 0, \"k\": 1 }, { \"n\": -1.4, \"z\": -570, \"k\": 1 }, { \"n\": -66.8, \"z\": -638.4, \"k\": 0 }, { \"n\": -97.7, \"z\": -718.7, \"k\": 0 }, { \"n\": -93.9, \"z\": -812, \"k\": 0.4 }, { \"n\": 203.6, \"z\": -814.7, \"k\": 0 }, { \"n\": 678.7, \"z\": -824.6, \"k\": 1 }] },\n    { \"u\": 0.091, \"keelK\": 0, \"points\": [{ \"n\": 0, \"z\": 0, \"k\": 1 }, { \"n\": 0, \"z\": -522.9, \"k\": 1 }, { \"n\": -55.2, \"z\": -604.6, \"k\": 0 }, { \"n\": -79.7, \"z\": -693.5, \"k\": 0 }, { \"n\": -73, \"z\": -790.3, \"k\": 0.55 }, { \"n\": 224.5, \"z\": -801.4, \"k\": 0 }, { \"n\": 699.1, \"z\": -827.9, \"k\": 1 }] },\n    { \"u\": 0.165, \"keelK\": 0, \"points\": [{ \"n\": 0.3, \"z\": 0, \"k\": 1 }, { \"n\": 0.3, \"z\": -448.7, \"k\": 1 }, { \"n\": -36.1, \"z\": -548.4, \"k\": 0 }, { \"n\": -49.2, \"z\": -650.4, \"k\": 0 }, { \"n\": -38.5, \"z\": -755.1, \"k\": 0.79 }, { \"n\": 256.8, \"z\": -782.5, \"k\": 0 }, { \"n\": 727.8, \"z\": -832.2, \"k\": 1 }] },\n    { \"u\": 0.268, \"keelK\": 0, \"points\": [{ \"n\": 0, \"z\": 0, \"k\": 1 }, { \"n\": 0, \"z\": -342, \"k\": 1 }, { \"n\": -5.1, \"z\": -470.5, \"k\": 0 }, { \"n\": 2.3, \"z\": -598, \"k\": 0 }, { \"n\": 22.2, \"z\": -725, \"k\": 1 }, { \"n\": 317.1, \"z\": -767.5, \"k\": 0 }, { \"n\": 787.3, \"z\": -835.3, \"k\": 1 }] },\n    { \"u\": 0.345, \"keelK\": 0, \"points\": [{ \"n\": 0.8, \"z\": 0, \"k\": 1 }, { \"n\": 0.8, \"z\": -256.4, \"k\": 1 }, { \"n\": 24.2, \"z\": -414.6, \"k\": 0 }, { \"n\": 52.2, \"z\": -572.5, \"k\": 0 }, { \"n\": 84.5, \"z\": -730, \"k\": 1 }, { \"n\": 380.9, \"z\": -771.4, \"k\": 0 }, { \"n\": 854.2, \"z\": -836.6, \"k\": 1 }] },\n    { \"u\": 0.421, \"keelK\": 0, \"points\": [{ \"n\": -1, \"z\": 0, \"k\": 1 }, { \"n\": -1, \"z\": -210, \"k\": 1 }, { \"n\": 46.6, \"z\": -385, \"k\": 0 }, { \"n\": 94.6, \"z\": -560, \"k\": 0 }, { \"n\": 143, \"z\": -735, \"k\": 1 }, { \"n\": 440.5, \"z\": -775.1, \"k\": 0 }, { \"n\": 914.9, \"z\": -839.6, \"k\": 1 }] },\n    { \"u\": 0.495, \"keelK\": 0, \"points\": [{ \"n\": 0.9, \"z\": 0, \"k\": 1 }, { \"n\": 0.9, \"z\": -211, \"k\": 1 }, { \"n\": 67.3, \"z\": -384, \"k\": 0 }, { \"n\": 134.2, \"z\": -557, \"k\": 0 }, { \"n\": 201.7, \"z\": -729.9, \"k\": 1 }, { \"n\": 499, \"z\": -773.9, \"k\": 0 }, { \"n\": 972.6, \"z\": -845.5, \"k\": 1 }] },\n    { \"u\": 0.571, \"keelK\": 0, \"points\": [{ \"n\": -2.2, \"z\": 0, \"k\": 1 }, { \"n\": -2.2, \"z\": -212, \"k\": 1 }, { \"n\": 74.8, \"z\": -382.7, \"k\": 0 }, { \"n\": 151.8, \"z\": -553.3, \"k\": 0 }, { \"n\": 228.8, \"z\": -724, \"k\": 1 }, { \"n\": 524.3, \"z\": -772, \"k\": 0 }, { \"n\": 994.8, \"z\": -848.4, \"k\": 1 }] },\n    { \"u\": 0.654, \"keelK\": 0, \"points\": [{ \"n\": 0.8, \"z\": 0, \"k\": 1 }, { \"n\": 0.8, \"z\": -167.5, \"k\": 1 }, { \"n\": 81.6, \"z\": -342.3, \"k\": 0 }, { \"n\": 162.2, \"z\": -516.9, \"k\": 0 }, { \"n\": 242.4, \"z\": -691.4, \"k\": 1 }, { \"n\": 515.9, \"z\": -753.8, \"k\": 0 }, { \"n\": 959.8, \"z\": -847.4, \"k\": 1 }] },\n    { \"u\": 0.773, \"keelK\": 0, \"points\": [{ \"n\": -8.6, \"z\": 0, \"k\": 1 }, { \"n\": -8.6, \"z\": -99.8, \"k\": 1 }, { \"n\": 92.2, \"z\": -270.6, \"k\": 0 }, { \"n\": 190.3, \"z\": -442.8, \"k\": 0 }, { \"n\": 286.1, \"z\": -616.3, \"k\": 1 }, { \"n\": 506, \"z\": -707.6, \"k\": 0 }, { \"n\": 879.1, \"z\": -840.6, \"k\": 1 }] },\n    { \"u\": 0.818, \"keelK\": 0, \"points\": [{ \"n\": 11.8, \"z\": 0, \"k\": 1 }, { \"n\": 11.8, \"z\": -87.3, \"k\": 1 }, { \"n\": 99.9, \"z\": -251.7, \"k\": 0 }, { \"n\": 191.9, \"z\": -421.7, \"k\": 0 }, { \"n\": 286.9, \"z\": -595.9, \"k\": 1 }, { \"n\": 496.6, \"z\": -698.9, \"k\": 0 }, { \"n\": 885.2, \"z\": -841.2, \"k\": 1 }] },\n    { \"u\": 0.862, \"keelK\": 0, \"points\": [{ \"n\": 49.4, \"z\": 0, \"k\": 1 }, { \"n\": 49.4, \"z\": -77.2, \"k\": 1 }, { \"n\": 122, \"z\": -229.1, \"k\": 0 }, { \"n\": 200.1, \"z\": -392.4, \"k\": 0 }, { \"n\": 284.3, \"z\": -565.5, \"k\": 1 }, { \"n\": 467.6, \"z\": -686.2, \"k\": 0 }, { \"n\": 889.2, \"z\": -841.6, \"k\": 1 }] },\n    { \"u\": 0.902, \"keelK\": 0, \"points\": [{ \"n\": 96.6, \"z\": 0, \"k\": 1 }, { \"n\": 96.6, \"z\": -68.4, \"k\": 1 }, { \"n\": 146.2, \"z\": -197.5, \"k\": 0 }, { \"n\": 207.2, \"z\": -346.2, \"k\": 0 }, { \"n\": 280, \"z\": -509.4, \"k\": 1 }, { \"n\": 408.6, \"z\": -635.1, \"k\": 0 }, { \"n\": 795.4, \"z\": -834.3, \"k\": 1 }] },\n    { \"u\": 0.928, \"keelK\": 0, \"points\": [{ \"n\": 162.1, \"z\": 0, \"k\": 1 }, { \"n\": 162.1, \"z\": -63.6, \"k\": 1 }, { \"n\": 191.6, \"z\": -164.9, \"k\": 0 }, { \"n\": 232.1, \"z\": -286.2, \"k\": 0 }, { \"n\": 284.1, \"z\": -433.1, \"k\": 1 }, { \"n\": 353.8, \"z\": -543.4, \"k\": 0 }, { \"n\": 636.1, \"z\": -793.6, \"k\": 1 }] },\n    { \"u\": 0.953, \"keelK\": 0, \"points\": [{ \"n\": 254.6, \"z\": 0, \"k\": 1 }, { \"n\": 254.6, \"z\": -60.7, \"k\": 1 }, { \"n\": 261.8, \"z\": -136.2, \"k\": 0 }, { \"n\": 273.8, \"z\": -219.3, \"k\": 0 }, { \"n\": 297.2, \"z\": -320.2, \"k\": 1 }, { \"n\": 311.4, \"z\": -341.1, \"k\": 0 }, { \"n\": 387.1, \"z\": -507.5, \"k\": 1 }] }\n  ]\n};\n\n// camber's origin in the model: world Y and Z (mm) of the plan's first point at the deck datum\nconst PLACE = [-300, 820];\n// deck crown above the sheer at the centreline, [Y, mm], read by the frames, transom and deck battens\nconst CROWN = [[-90, 110], [0, 105], [300, 70], [900, 45], [1880, 50], [2870, 55.5], [3850, 50], [4300, 15], [4400, 0]];\n// frame stations (Y of each frame's centre plane), the stem, read by the frames, keel, stem and battens\nconst PARTS = { frames: [900, 1880, 2870, 3850], stem: { aftEndY: 3400, moulding: 110, siding: 40 } };\n\nfunction run(): string {\n  const c = CAMBER, f = (v: number) => Math.round(v * 100) / 100;\n  return JSON.stringify({\n    camber: {\n      deg: c.deckTrimDeg,\n      p: c.sheerPlan.map((q: any) => [f(q.x), f(q.y)]),\n      t: c.sheerTrim.map((q: any) => [f(q.x), f(q.z)]),\n      tr: c.transom.map((q: any) => [f(q.x), f(q.z)]),\n      s: c.stations.map((s: any) => [s.u, ...s.points.flatMap((q: any) => [f(q.n), f(q.z), q.k])]),\n    },\n    place: PLACE, crown: CROWN, ...PARTS,\n  });\n}\n",
      "compiledCode": "\"use strict\";\n/**\n * The boat's hull, as a camber hull document (github.com/electricshipwrights/camber, format version 2, mm), plus\n * the few numbers the hull parts need besides the hull surface. Every hull Code atom reads this table: the skin\n * sweeps the camber surface, and the frames, transom, keel, stem and battens are cut from the same surface.\n *\n * To reshape the hull, edit CAMBER here, or paste a document exported from the camber editor\n * (https://risingtideresearch.github.io/camber/) over it. It was fitted to the reference photos, read with the boat\n * upside down on its building jig: four frames about 985 mm apart (frame 3 is the one cut on the Maslow, #4 the\n * narrow one forward), and a barrel-back runabout stern: a low raked transom (top aft) with a flat bottom and sides\n * that tumble home to the deck, the deck sweeping down to it. Overall scale and heights are photo estimates.\n *\n * Camber's frame: x runs aft→forward, y is the half-breadth, z is up from a flat deck datum (the hull hangs below\n * it). PLACE puts camber's origin (x 0, z 0) at world (Y, Z); world X is camber's y. Forward of frame 4 the sheer\n * plan runs on past the stem as construction geometry.\n */\nconst CAMBER = {\n    \"version\": 2,\n    \"name\": \"Boat_Test runabout\",\n    \"unit\": \"mm\",\n    \"waterline\": 0,\n    \"deckTrimDeg\": 0,\n    \"sheerPlan\": [{ \"x\": 0, \"y\": 487.7 }, { \"x\": 200, \"y\": 487.7 }, { \"x\": 420, \"y\": 520 }, { \"x\": 750, \"y\": 553.4 }, { \"x\": 1200, \"y\": 604.3 }, { \"x\": 1800, \"y\": 690.8 }, { \"x\": 2400, \"y\": 756.8 }, { \"x\": 3000, \"y\": 836.8 }, { \"x\": 3600, \"y\": 801.8 }, { \"x\": 4000, \"y\": 749.4 }, { \"x\": 4300, \"y\": 703.1 }, { \"x\": 4600, \"y\": 490.5 }, { \"x\": 4930, \"y\": 148.3 }, { \"x\": 5050, \"y\": 0 }],\n    \"sheerTrim\": [{ \"x\": 0, \"z\": -645.2, \"k\": 0 }, { \"x\": 150, \"z\": -601.2, \"k\": 0 }, { \"x\": 240, \"z\": -574.7, \"k\": 0 }, { \"x\": 600, \"z\": -474.2, \"k\": 0 }, { \"x\": 1200, \"z\": -342, \"k\": 0 }, { \"x\": 2180, \"z\": -210, \"k\": 0 }, { \"x\": 3170, \"z\": -212, \"k\": 0 }, { \"x\": 4150, \"z\": -100, \"k\": 0 }, { \"x\": 4450, \"z\": -75, \"k\": 0 }, { \"x\": 4600, \"z\": -64, \"k\": 0 }, { \"x\": 4670, \"z\": -60, \"k\": 0 }, { \"x\": 4900, \"z\": -60, \"k\": 0 }],\n    \"transom\": [{ \"x\": 211.9, \"z\": -466.8 }, { \"x\": 300, \"z\": -820 }],\n    \"stations\": [\n        { \"u\": 0, \"keelK\": 0, \"points\": [{ \"n\": 14.7, \"z\": 0, \"k\": 1 }, { \"n\": 14.7, \"z\": -645.2, \"k\": 1 }, { \"n\": -56.2, \"z\": -678.7, \"k\": 0 }, { \"n\": -97.1, \"z\": -734.3, \"k\": 0 }, { \"n\": -107.9, \"z\": -812, \"k\": 0.4 }, { \"n\": 189.9, \"z\": -816, \"k\": 0 }, { \"n\": 666.4, \"z\": -822.4, \"k\": 1 }] },\n        { \"u\": 0.048, \"keelK\": 0, \"points\": [{ \"n\": -1.4, \"z\": 0, \"k\": 1 }, { \"n\": -1.4, \"z\": -570, \"k\": 1 }, { \"n\": -66.8, \"z\": -638.4, \"k\": 0 }, { \"n\": -97.7, \"z\": -718.7, \"k\": 0 }, { \"n\": -93.9, \"z\": -812, \"k\": 0.4 }, { \"n\": 203.6, \"z\": -814.7, \"k\": 0 }, { \"n\": 678.7, \"z\": -824.6, \"k\": 1 }] },\n        { \"u\": 0.091, \"keelK\": 0, \"points\": [{ \"n\": 0, \"z\": 0, \"k\": 1 }, { \"n\": 0, \"z\": -522.9, \"k\": 1 }, { \"n\": -55.2, \"z\": -604.6, \"k\": 0 }, { \"n\": -79.7, \"z\": -693.5, \"k\": 0 }, { \"n\": -73, \"z\": -790.3, \"k\": 0.55 }, { \"n\": 224.5, \"z\": -801.4, \"k\": 0 }, { \"n\": 699.1, \"z\": -827.9, \"k\": 1 }] },\n        { \"u\": 0.165, \"keelK\": 0, \"points\": [{ \"n\": 0.3, \"z\": 0, \"k\": 1 }, { \"n\": 0.3, \"z\": -448.7, \"k\": 1 }, { \"n\": -36.1, \"z\": -548.4, \"k\": 0 }, { \"n\": -49.2, \"z\": -650.4, \"k\": 0 }, { \"n\": -38.5, \"z\": -755.1, \"k\": 0.79 }, { \"n\": 256.8, \"z\": -782.5, \"k\": 0 }, { \"n\": 727.8, \"z\": -832.2, \"k\": 1 }] },\n        { \"u\": 0.268, \"keelK\": 0, \"points\": [{ \"n\": 0, \"z\": 0, \"k\": 1 }, { \"n\": 0, \"z\": -342, \"k\": 1 }, { \"n\": -5.1, \"z\": -470.5, \"k\": 0 }, { \"n\": 2.3,