      "interpreterVersion": 1,
      "code": "/**\n * The boat's hull, as a camber hull document (github.com/electricshipwrights/camber, format version 2, mm), plus\n * the few numbers the hull parts need besides the hull surface. Every hull Code atom reads this table: the skin\n * sweeps the camber surface, and the frames, transom, keel, stem and battens are cut from the same surface.\n *\n * To reshape the hull, edit CAMBER here, or paste a document exported from the camber editor\n * (https://risingtideresearch.github.io/camber/) over it. It was fitted to the reference photos (the build photo\n * shows the boat upside down on its jig) and shaped like the Glen-L Squirt in the photo of a finished sister boat:\n * four frames, from the transom A, B, C (the frame cut on the Maslow, widest) and #4 (the narrow one), so the hull is\n * widest at mid-length; a fine bow with a raked stem and cut-away forefoot; and a barrel-back runabout stern: a low\n * raked transom (top aft) with a flat bottom and sides that tumble home to the deck, the deck sweeping down to it.\n * The lines are faired (smooth curvature, no ripple between stations) through the measured frames. Overall scale\n * and heights are photo estimates (4.2 m deck length).\n *\n * Camber's frame: x runs aft→forward, y is the half-breadth, z is up from a flat deck datum (the hull hangs below\n * it). PLACE puts camber's origin (x 0, z 0) at world (Y, Z); world X is camber's y. Forward of frame #4 the sheer\n * plan runs on past the stem as construction geometry.\n */\nconst CAMBER = {\n  \"version\": 2,\n  \"name\": \"Boat_Test runabout\",\n  \"unit\": \"mm\",\n  \"waterline\": 0,\n  \"deckTrimDeg\": 0,\n  \"sheerPlan\": [{ \"x\": 0, \"y\": 424.8 }, { \"x\": 150, \"y\": 462.2 }, { \"x\": 300, \"y\": 505 }, { \"x\": 500, \"y\": 553.2 }, { \"x\": 750, \"y\": 606.3 }, { \"x\": 1050, \"y\": 661.9 }, { \"x\": 1400, \"y\": 715.3 }, { \"x\": 1800, \"y\": 760 }, { \"x\": 2200, \"y\": 789 }, { \"x\": 2600, \"y\": 796.5 }, { \"x\": 3000, \"y\": 779.7 }, { \"x\": 3350, \"y\": 739.2 }, { \"x\": 3650, \"y\": 677.8 }, { \"x\": 3900, \"y\": 599.3 }, { \"x\": 4100, \"y\": 506.2 }, { \"x\": 4300, \"y\": 399.4 }, { \"x\": 4500, \"y\": 279.2 }, { \"x\": 4680, \"y\": 145.9 }, { \"x\": 4800, \"y\": 0 }],\n  \"sheerTrim\": [{ \"x\": 0, \"z\": -671.1, \"k\": 0 }, { \"x\": 150, \"z\": -610.1, \"k\": 0 }, { \"x\": 240, \"z\": -575.9, \"k\": 0 }, { \"x\": 400, \"z\": -519.5, \"k\": 0 }, { \"x\": 600, \"z\": -456.9, \"k\": 0 }, { \"x\": 800, \"z\": -403.4, \"k\": 0 }, { \"x\": 1000, \"z\": -358.9, \"k\": 0 }, { \"x\": 1200, \"z\": -323.1, \"k\": 0 }, { \"x\": 1400, \"z\": -295.3, \"k\": 0 }, { \"x\": 1600, \"z\": -274.4, \"k\": 0 }, { \"x\": 1800, \"z\": -258.8, \"k\": 0 }, { \"x\": 2000, \"z\": -246.5, \"k\": 0 }, { \"x\": 2200, \"z\": -235.1, \"k\": 0 }, { \"x\": 2400, \"z\": -222.5, \"k\": 0 }, { \"x\": 2600, \"z\": -207, \"k\": 0 }, { \"x\": 2800, \"z\": -187.7, \"k\": 0 }, { \"x\": 3000, \"z\": -165.2, \"k\": 0 }, { \"x\": 3200, \"z\": -140.4, \"k\": 0 }, { \"x\": 3400, \"z\": -114.8, \"k\": 0 }, { \"x\": 3600, \"z\": -89.6, \"k\": 0 }, { \"x\": 3800, \"z\": -65.6, \"k\": 0 }, { \"x\": 4000, \"z\": -43.4, \"k\": 0 }, { \"x\": 4150, \"z\": -28.1, \"k\": 0 }, { \"x\": 4250, \"z\": -18.6, \"k\": 0 }, { \"x\": 4330, \"z\": -11.3, \"k\": 0 }, { \"x\": 4380, \"z\": -6.9, \"k\": 0 }, { \"x\": 4412, \"z\": -4.6, \"k\": 0 }, { \"x\": 4600, \"z\": -4.6, \"k\": 0 }],\n  \"transom\": [{ \"x\": 211.9, \"z\": -466.8 }, { \"x\": 300, \"z\": -820 }],\n  \"stations\": [\n    { \"u\": 0.023, \"keelK\": 0, \"points\": [{ \"n\": -20.4, \"z\": 0, \"k\": 1 }, { \"n\": -20.4, \"z\": -616.1, \"k\": 1 }, { \"n\": -91, \"z\": -669.4, \"k\": 0 }, { \"n\": -130, \"z\": -736.1, \"k\": 0 }, { \"n\": -136.8, \"z\": -820.2, \"k\": 0.36 }, { \"n\": 170.1, \"z\": -821.2, \"k\": 0 }, { \"n\": 664.4, \"z\": -823.4, \"k\": 1 }] },\n    { \"u\": 0.051, \"keelK\": 0, \"points\": [{ \"n\": -8.3, \"z\": 0, \"k\": 1 }, { \"n\": -8.3, \"z\": -570.8, \"k\": 1 }, { \"n\": -74.3, \"z\": -641.7, \"k\": 0 }, { \"n\": -106.7, \"z\": -721.4, \"k\": 0 }, { \"n\": -104.1, \"z\": -813.6, \"k\": 0.39 }, { \"n\": 202.9, \"z\": -814.6, \"k\": 0 }, { \"n\": 697.4, \"z\": -825.9, \"k\": 1 }] },\n    { \"u\": 0.1, \"keelK\": 0, \"points\": [{ \"n\": 6.2, \"z\": 0, \"k\": 1 }, { \"n\": 6.2, \"z\": -512.3, \"k\": 1 }, { \"n\": -49.1, \"z\": -604.1, \"k\": 0 }, { \"n\": -71.4, \"z\": -700.1, \"k\": 0 }, { \"n\": -59.2, \"z\": -802.8, \"k\": 0.53 }, { \"n\": 245, \"z\": -809.1, \"k\": 0 }, { \"n\": 735, \"z\": -829.1, \"k\": 1 }] },\n    { \"u\": 0.157, \"keelK\": 0, \"points\": [{ \"n\": 16.9, \"z\": 0, \"k\": 1 }, { \"n\": 16.9, \"z\": -447.3, \"k\": 1 }, { \"n\": -20.4, \"z\": -560, \"k\": 0 }, { \"n\": -29.6, \"z\": -673, \"k\": 0 }, { \"n\": -9.6, \"z\": -787.8, \"k\": 0.8 }, { \"n\": 292.1, \"z\": -801.7, \"k\": 0 }, { \"n\": 778, \"z\": -833.4, \"k\": 1 }] },\n    { \"u\": 0.222, \"keelK\": 0, \"points\": [{ \"n\": 22, \"z\": 0, \"k\": 1 }, { \"n\": 22, \"z\": -374.8, \"k\": 1 }, { \"n\": 13.2, \"z\": -507.1, \"k\": 0 }, { \"n\": 22.2, \"z\": -637.6, \"k\": 0 }, { \"n\": 49.3, \"z\": -766.9, \"k\": 1 }, { \"n\": 348.7, \"z\": -791.7, \"k\": 0 }, { \"n\": 830.8, \"z\": -839, \"k\": 1 }] },\n    { \"u\": 0.275, \"keelK\": 0, \"points\": [{ \"n\": 18.5, \"z\": 0, \"k\": 1 }, { \"n\": 18.5, \"z\": -324.3, \"k\": 1 }, { \"n\": 35.3, \"z\": -467.5, \"k\": 0 }, { \"n\": 60.8, \"z\": -609.3, \"k\": 0 }, { \"n\": 94.7, \"z\": -749.9, \"k\": 1 }, { \"n\": 392.7, \"z\": -783.7, \"k\": 0 }, { \"n\": 872.8, \"z\": -843.3, \"k\": 1 }] },\n    { \"u\": 0.321, \"keelK\": 0, \"points\": [{ \"n\": 8.6, \"z\": 0, \"k\": 1 }, { \"n\": 8.6, \"z\": -288.3, \"k\": 1 }, { \"n\": 46.4, \"z\": -438.2, \"k\": 0 }, { \"n\": 86.9, \"z\": -587.8, \"k\": 0 }, { \"n\": 129.8, \"z\": -737, \"k\": 1 }, { \"n\": 427.7, \"z\": -777.8, \"k\": 0 }, { \"n\": 908, \"z\": -846.3, \"k\": 1 }] },\n    { \"u\": 0.364, \"keelK\": 0, \"points\": [{ \"n\": -4.8, \"z\": 0, \"k\": 1 }, { \"n\": -4.8, \"z\": -263.8, \"k\": 1 }, { \"n\": 47.8, \"z\": -418.8, \"k\": 0 }, { \"n\": 100.9, \"z\": -573.9, \"k\": 0 }, { \"n\": 154.4, \"z\": -729.2, \"k\": 1 }, { \"n\": 454.1, \"z\": -774.3, \"k\": 0 }, { \"n\": 937.1, \"z\": -848, \"k\": 1 }] },\n    { \"u\": 0.406, \"keelK\": 0, \"points\": [{ \"n\": -17.4, \"z\": 0, \"k\": 1 }, { \"n\": -17.4, \"z\": -246.6, \"k\": 1 }, { \"n\": 45.2, \"z\": -406.2, \"k\": 0 }, { \"n\": 108.1, \"z\": -566, \"k\": 0 }, { \"n\": 171.3, \"z\": -726, \"k\": 1 }, { \"n\": 473.4, \"z\": -773, \"k\": 0 }, { \"n\": 959.3, \"z\": -848.6, \"k\": 1 }] },\n    { \"u\": 0.448, \"keelK\": 0, \"points\": [{ \"n\": -26, \"z\": 0, \"k\": 1 }, { \"n\": -26, \"z\": -231, \"k\": 1 }, { \"n\": 44.3, \"z\": -395.8, \"k\": 0 }, { \"n\": 114.7, \"z\": -560.6, \"k\": 0 }, { \"n\": 185.2, \"z\": -725.5, \"k\": 1 }, { \"n\": 487.2, \"z\": -772.8, \"k\": 0 }, { \"n\": 971.8, \"z\": -848.7, \"k\": 1 }] },\n    { \"u\": 0.491, \"keelK\": 0, \"points\": [{ \"n\": -29.1, \"z\": 0, \"k\": 1 }, { \"n\": -29.1, \"z\": -212, \"k\": 1 }, { \"n\": 47.9, \"z\": -382.7, \"k\": 0 }, { \"n\": 124.9, \"z\": -553.3, \"k\": 0 }, { \"n\": 201.8, \"z\": -724, \"k\": 1 }, { \"n\": 497.4, \"z\": -772, \"k\": 0 }, { \"n\": 972.3, \"z\": -849.1, \"k\": 1 }] },\n    { \"u\": 0.534, \"keelK\": 0, \"points\": [{ \"n\": -28.7, \"z\": 0, \"k\": 1 }, { \"n\": -28.7, \"z\": -186, \"k\": 1 }, { \"n\": 56.7, \"z\": -362.3, \"k\": 0 }, { \"n\": 141.7, \"z\": -538.5, \"k\": 0 }, { \"n\": 226.6, \"z\": -714.5, \"k\": 1 }, { \"n\": 506, \"z\": -767.7, \"k\": 0 }, { \"n\": 958.7, \"z\": -851.4, \"k\": 1 }] },\n    { \"u\": 0.579, \"keelK\": 0, \"points\": [{ \"n\": -21.8, \"z\": 0, \"k\": 1 }, { \"n\": -21.8, \"z\": -154, \"k\": 1 }, { \"n\": 72.6, \"z\": -331.8, \"k\": 0 }, { \"n\": 166.4, \"z\": -509.7, \"k\": 0 }, { \"n\": 259.7, \"z\": -687.9, \"k\": 1 }, { \"n\": 512.5, \"z\": -755.7, \"k\": 0 }, { \"n\": 929.3, \"z\": -857.2, \"k\": 1 }] },\n    { \"u\": 0.629, \"keelK\": 0, \"points\": [{ \"n\": 1.4, \"z\": 0, \"k\": 1 }, { \"n\": 1.4, \"z\": -119.7, \"k\": 1 }, { \"n\": 99.9, \"z\": -290.6, \"k\": 0 }, { \"n\": 198.2, \"z\": -463, \"k\": 0 }, { \"n\": 296.1, \"z\": -636.8, \"k\": 1 }, { \"n\": 513.8, \"z\": -727.9, \"k\": 0 }, { \"n\": 882.4, \"z\": -861.1, \"k\": 1 }] },\n    { \"u\": 0.665, \"keelK\": 0, \"points\": [{ \"n\": 29.1, \"z\": 0, \"k\": 1 }, { \"n\": 29.1, \"z\": -97.8, \"k\": 1 }, { \"n\": 125.1, \"z\": -258.2, \"k\": 0 }, { \"n\": 221.7, \"z\": -421.8, \"k\": 0 }, { \"n\": 318.7, \"z\": -588.6, \"k\": 1 }, { \"n\": 509.8, \"z\": -694.9, \"k\": 0 }, { \"n\": 841.5, \"z\": -850.8, \"k\": 1 }] },\n    { \"u\": 0.703, \"keelK\": 0, \"points\": [{ \"n\": 63.9, \"z\": 0, \"k\": 1 }, { \"n\": 63.9, \"z\": -78.3, \"k\": 1 }, { \"n\": 152.8, \"z\": -224.3, \"k\": 0 }, { \"n\": 243.7, \"z\": -375.6, \"k\": 0 }, { \"n\": 336.4, \"z\": -532.2, \"k\": 1 }, { \"n\": 500.6, \"z\": -650.6, \"k\": 0 }, { \"n\": 794.3, \"z\": -828, \"k\": 1 }] },\n    { \"u\": 0.744, \"keelK\": 0, \"points\": [{ \"n\": 100.5, \"z\": 0, \"k\": 1 }, { \"n\": 100.5, \"z\": -61.5, \"k\": 1 }, { \"n\": 179.1, \"z\": -190.6, \"k\": 0 }, { \"n\": 261.3, \"z\": -327.4, \"k\": 0 }, { \"n\": 346.9, \"z\": -471.8, \"k\": 1 }, { \"n\": 485.3, \"z\": -597.3, \"k\": 0 }, { \"n\": 743.1, \"z\": -792.5, \"k\": 1 }] },\n    { \"u\": 0.788, \"keelK\": 0, \"points\": [{ \"n\": 134.3, \"z\": 0, \"k\": 1 }, { \"n\": 134.3, \"z\": -47.3, \"k\": 1 }, { \"n\": 200.7, \"z\": -157.7, \"k\": 0 }, { \"n\": 272.1, \"z\": -277.7, \"k\": 0 }, { \"n\": 348.5, \"z\": -407.6, \"k\": 1 }, { \"n\": 461.9, \"z\": -533.2, \"k\": 0 }, { \"n\": 683, \"z\": -740.1, \"k\": 1 }] },\n    { \"u\": 0.83, \"keelK\": 0, \"points\": [{ \"n\": 166, \"z\": 0, \"k\": 1 }, { \"n\": 166, \"z\": -35.3, \"k\": 1 }, { \"n\": 219.7, \"z\": -125.6, \"k\": 0 }, { \"n\": 278.8, \"z\": -225.6, \"k\": 0 }, { \"n\": 343.8, \"z\": -336.4, \"k\": 1 }, { \"n\": 429.9, \"z\": -449.8, \"k\": 0 }, { \"n\": 603, \"z\": -650.1, \"k\": 1 }] },\n    { \"u\": 0.866, \"keelK\": 0, \"points\": [{ \"n\": 195.6, \"z\": 0, \"k\": 1 }, { \"n\": 195.6, \"z\": -25.7, \"k\": 1 }, { \"n\": 237.4, \"z\": -97, \"k\": 0 }, { \"n\": 284.3, \"z\": -177.3, \"k\": 0 }, { \"n\": 337.2, \"z\": -267.8, \"k\": 1 }, { \"n\": 397.8, \"z\": -359.6, \"k\": 0 }, { \"n\": 524.7, \"z\": -535.1, \"k\": 1 }] },\n    { \"u\": 0.894, \"keelK\": 0, \"points\": [{ \"n\": 219.9, \"z\": 0, \"k\": 1 }, { \"n\": 219.9, \"z\": -18.8, \"k\": 1 }, { \"n\": 251.9, \"z\": -74.5, \"k\": 0 }, { \"n\": 288.4, \"z\": -137.9, \"k\": 0 }, { \"n\": 330.3, \"z\": -210.6, \"k\": 1 }, { \"n\": 370.4, \"z\": -277.8, \"k\": 0 }, { \"n\": 461.1, \"z\": -420.7, \"k\": 1 }] },\n    { \"u\": 0.916, \"keelK\": 0, \"points\": [{ \"n\": 239.8, \"z\": 0, \"k\": 1 }, { \"n\": 239.8, \"z\": -13.4, \"k\": 1 }, { \"n\": 263.4, \"z\": -55.9, \"k\": 0 }, { \"n\": 290.8, \"z\": -104.8, \"k\": 0 }, { \"n\": 322.8, \"z\": -161.5, \"k\": 1 }, { \"n\": 346.2, \"z\": -203.9, \"k\": 0 }, { \"n\": 407.9, \"z\": -311.4, \"k\": 1 }] },\n    { \"u\": 0.944, \"keelK\": 0, \"points\": [{ \"n\": 265.4, \"z\": 0, \"k\": 1 }, { \"n\": 265.4, \"z\": -6.7, \"k\": 1 }, { \"n\": 277.6, \"z\": -30.9, \"k\": 0 }, { \"n\": 292.1, \"z\": -59, \"k\": 0 }, { \"n\": 309.5, \"z\": -91.9, \"k\": 1 }, { \"n\": 323.3, \"z\": -118.8, \"k\": 0 }, { \"n\": 333.7, \"z\": -139.1, \"k\": 1 }] }\n  ]\n};\n\n// camber's origin in the model: world Y and Z (mm) of the plan's first point at the deck datum\nconst PLACE = [-300, 820];\n// deck crown above the sheer at the centreline, [Y, mm] (a faired curve, sampled), read by the frames, transom and deck battens\nconst CROWN = [[-90,110],[-44,107],[50,100.7],[150,93.9],[250,87],[350,80.3],[470,72.8],[620,64.8],[800,58],[1000,53.8],[1200,52.5],[1430,52.9],[1700,54],[2000,55],[2240,55.5],[2500,55.6],[2800,54.1],[3062,50],[3300,43.3],[3500,35.3],[3700,25.4],[3850,16.9],[3950,10.7],[4030,5.5],[4080,2.2],[4112,0]];\n// frame stations (Y of each frame's centre plane), the stem, read by the frames, keel, stem and battens\nconst PARTS = { frames: [620, 1430, 2240, 3062], stem: { aftEndY: 3150, moulding: 110, siding: 40 } };\n\nfunction run(): string {\n  const c = CAMBER, f = (v: number) => Math.round(v * 100) / 100;\n  return JSON.stringify({\n    camber: {\n      deg: c.deckTrimDeg,\n      p: c.sheerPlan.map((q: any) => [f(q.x), f(q.y)]),\n      t: c.sheerTrim.map((q: any) => [f(q.x), f(q.z)]),\n      tr: c.transom.map((q: any) => [f(q.x), f(q.z)]),\n      s: c.stations.map((s: any) => [s.u, ...s.points.flatMap((q: any) => [f(q.n), f(q.z), q.k])]),\n    },\n    place: PLACE, crown: CROWN, ...PARTS,\n  });\n}\n",
      "compiledCode": "\"use strict\";\n/**\n * The boat's hull, as a camber hull document (github.com/electricshipwrights/camber, format version 2, mm), plus\n * the few numbers the hull parts need besides the hull surface. Every hull Code atom reads this table: the skin\n * sweeps the camber surface, and the frames, transom, keel, stem and battens are cut from the same surface.\n *\n * To reshape the hull, edit CAMBER here, or paste a document exported from the camber editor\n * (https://risingtideresearch.github.io/camber/) over it. It was fitted to the reference photos (the build photo\n * shows the boat upside down on its jig) and shaped like the Glen-L Squirt in the photo of a finished sister boat:\n * four frames, from the transom A, B, C (the frame cut on the Maslow, widest) and #4 (the narrow one), so the hull is\n * widest at mid-length; a fine bow with a raked stem and cut-away forefoot; and a barrel-back runabout stern: a low\n * raked transom (top aft) with a flat bottom and sides that tumble home to the deck, the deck sweeping down to it.\n * The lines are faired (smooth curvature, no ripple between stations) through the measured frames. Overall scale\n * and heights are photo estimates (4.2 m deck length).\n *\n * Camber's frame: x runs aft→forward, y is the half-breadth, z is up from a flat deck datum (the hull hangs below\n * it). PLACE puts camber's origin (x 0, z 0) at world (Y, Z); world X is camber's y. Forward of frame #4 the sheer\n * plan runs on past the stem as construction geometry.\n */\nconst CAMBER = {\n    \"version\": 2,\n    \"name\": \"Boat_Test runabout\",\n    \"unit\": \"mm\",\n    \"waterline\": 0,\n    \"deckTrimDeg\": 0,\n    \"sheerPlan\": [{ \"x\": 0, \"y\": 424.8 }, { \"x\": 150, \"y\": 462.2 }, { \"x\": 300, \"y\": 505 }, { \"x\": 500, \"y\": 553.2 }, { \"x\": 750, \"y\": 606.3 }, { \"x\": 1050, \"y\": 661.9 }, { \"x\": 1400, \"y\": 715.3 }, { \"x\": 1800, \"y\": 760 }, { \"x\": 2200, \"y\": 789 }, { \"x\": 2600, \"y\": 796.5 }, { \"x\": 3000, \"y\": 779.7 }, { \"x\": 3350, \"y\": 739.2 }, { \"x\": 3650, \"y\": 677.8 }, { \"x\": 3900, \"y\": 599.3 }, { \"x\": 4100, \"y\": 506.2 }, { \"x\": 4300, \"y\": 399.4 }, { \"x\": 4500, \"y\": 279.2 }, { \"x\": 4680, \"y\": 145.9 }, { \"x\": 4800, \"y\": 0 }],\n    \"sheerTrim\": [{ \"x\": 0, \"z\": -671.1, \"k\": 0 }, { \"x\": 150, \"z\": -610.1, \"k\": 0 }, { \"x\": 240, \"z\": -575.9, \"k\": 0 }, { \"x\": 400, \"z\": -519.5, \"k\": 0 }, { \"x\": 600, \"z\": -456.9, \"k\": 0 }, { \"x\": 800, \"z\": -403.4, \"k\": 0 }, { \"x\": 1000, \"z\": -358.9, \"k\": 0 }, { \"x\": 1200, \"z\": -323.1, \"k\": 0 }, { \"x\": 1400, \"z\": -295.3, \"k\": 0 }, { \"x\": 1600, \"z\": -274.4, \"k\": 0 }, { \"x\": 1800, \"z\": -258.8, \"k\": 0 }, { \"x\": 2000, \"z\": -246.5, \"k\": 0 }, { \"x\": 2200, \"z\": -235.1, \"k\": 0 }, { \"x\": 2400, \"z\": -222.5, \"k\": 0 }, { \"x\": 2600, \"z\": -207, \"k\": 0 }, { \"x\": 2800, \"z\": -187.7, \"k\": 0 }, { \"x\": 3000, \"z\": -165.2, \"k\": 0 }, { \"x\": 3200, \"z\": -140.4, \"k\": 0 }, { \"x\": 3400, \"z\": -114.8, \"k\": 0 }, { \"x\": 3600, \"z\": -89.6, \"k\": 0 }, { \"x\": 3800, \"z\": -65.6, \"k\": 0 }, { \"x\": 4000, \"z\": -43.4, \"k\": 0 }, { \"x\": 4150, \"z\": -28.1, \"k\": 0 }, { \"x\": 4250, \"z\": -18.6, \"k\": 0 }, { \"x\": 4330, \"z\": -11.3, \"k\": 0 }, { \"x\": 4380, \"z\": -6.9, \"k\": 0 }, { \"x\": 4412, \"z\": -4.6, \"k\": 0 }, { \"x\": 4600, \"z\": -4.6, \"k\": 0 }],\n    \"transom\": [{ \"x\": 211.9, \"z\": -466.8 }, { \"x\": 300, \"z\": -820 }],\n    \"stations\": [\n        { \"u\": 0.023, \"keelK\": 0, \"points\": [{ \"n\": -20.4, \"z\": 0, \"k\": 1 }, { \"n\": -20.4, \"z\": -616.1, \"k\": 1 }, { \"n\": -91, \"z\": -669.4, \"k\": 0 }, { \"n\": -130, \"z\": -736.1, \"k\": 0 }, { \"n\": -136.8, \"z\": -820.2, \"k\": 0.36 }, { \"n\": 170.1, \"z\": -821.2, \"k\": 0 }, { \"n\": 664.4, \"z\": -823.4, \"k\": 1 }] },\n        { \"u\": 0.051, \"keelK\": 0, \"points\": [{ \"n\": -8.3, \"z\": 0, \"k\": 1 