20.2,1,311.4,-341.1,0,387.1,-507.5,1]]},\"place\":[-300,820],\"crown\":[[-90,110],[0,105],[300,70],[900,45],[1880,50],[2870,55.5],[3850,50],[4300,15],[4400,0]],\"frames\":[900,1880,2870,3850],\"stem\":{\"aftEndY\":3400,\"moulding\":110,\"siding\":40}}"
