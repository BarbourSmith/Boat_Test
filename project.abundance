              "ioValue": "{\"camber\":{\"deg\":0,\"p\":[[0,424.8],[150,462.2],[300,505],[500,553.2],[750,606.3],[1050,661.9],[1400,715.3],[1800,760],[2200,789],[2600,796.5],[3000,779.7],[3350,739.2],[3650,677.8],[3900,599.3],[4100,506.2],[4300,399.4],[4500,279.2],[4680,145.9],[4800,0]],\"t\":[[0,-671.1],[150,-610.1],[240,-575.9],[400,-519.5],[600,-456.9],[800,-403.4],[1000,-358.9],[1200,-323.1],[1400,-295.3],[1600,-274.4],[1800,-258.8],[2000,-246.5],[2200,-235.1],[2400,-222.5],[2600,-207],[2800,-187.7],[3000,-165.2],[3200,-140.4],[3400,-114.8],[3600,-89.6],[3800,-65.6],[4000,-43.4],[4150,-28.1],[4250,-18.6],[4330,-11.3],[4380,-6.9],[4412,-4.6],[4600,-4.6]],\"tr\":[[211.9,-466.8],[300,-820]],\"s\":[[0.023,-20.4,0,1,-20.4,-616.1,1,-91,-669.4,0,-130,-736.1,0,-136.8,-820.2,0.36,170.1,-821.2,0,664.4,-823.4,1],[0.051,-8.3,0,1,-8.3,-570.8,1,-74.3,-641.7,0,-106.7,-721.4,0,-104.1,-813.6,0.39,202.9,-814.6,0,697.4,-825.9,1],[0.1,6.2,0,1,6.2,-512.3,1,-49.1,-604.1,0,-71.4,-700.1,0,-59.2,-802.8,0.53,245,-809.1,0,735,-829.1,1],[0.157,16.9,0,1,16.9,-447.3,1,-20.4,-560,0,-29.6,-673,0,-9.6,-787.8,0.8,292.1,-801.7,0,778,-833.4,1],[0.222,22,0,1,22,-374.8,1,13.2,-507.1,0,22.2,-637.6,0,49.3,-766.9,1,348.7,-791.7,0,830.8,-839,1],[0.275,18.5,0,1,18.5,-324.3,1,35.3,-467.5,0,60.8,-609.3,0,94.7,-749.9,1,392.7,-783.7,0,872.8,-843.3,1],[0.321,8.6,0,1,8.6,-288.3,1,46.4,-438.2,0,86.9,-587.8,0,129.8,-737,1,427.7,-777.8,0,908,-846.3,1],[0.364,-4.8,0,1,-4.8,-263.8,1,47.8,-418.8,0,100.9,-573.9,0,154.4,-729.2,1,454.1,-774.3,0,937.1,-848,1],[0.406,-17.4,0,1,-17.4,-246.6,1,45.2,-406.2,0,108.1,-566,0,171.3,-726,1,473.4,-773,0,959.3,-848.6,1],[0.448,-26,0,1,-26,-231,1,44.3,-395.8,0,114.7,-560.6,0,185.2,-725.5,1,487.2,-772.8,0,971.8,-848.7,1],[0.491,-29.1,0,1,-29.1,-212,1,47.9,-382.7,0,124.9,-553.3,0,201.8,-724,1,497.4,-772,0,972.3,-849.1,1],[0.534,-28.7,0,1,-28.7,-186,1,56.7,-362.3,0,141.7,-538.5,0,226.6,-714.5,1,506,-767.7,0,958.7,-851.4,1],[0.579,-21.8,0,1,-21.8,-154,1,72.6,-331.8,0,166.4,-509.7,0,259.7,-687.9,1,512.5,-755.7,0,929.3,-857.2,1],[0.629,1.4,0,1,1.4,-119.7,1,99.9,-290.6,0,198.2,-463,0,296.1,-636.8,1,513.8,-727.9,0,882.4,-861.1,1],[0.665,29.1,0,1,29.1,-97.8,1,125.1,-258.2,0,221.7,-421.8,0,318.7,-588.6,1,509.8,-694.9,0,841.5,-850.8,1],[0.703,63.9,0,1,63.9,-78.3,1,152.8,-224.3,0,243.7,-375.6,0,336.4,-532.2,1,500.6,-650.6,0,794.3,-828,1],[0.744,100.5,0,1,100.5,-61.5,1,179.1,-190.6,0,261.3,-327.4,0,346.9,-471.8,1,485.3,-597.3,0,743.1,-792.5,1],[0.788,134.3,0,1,134.3,-47.3,1,200.7,-157.7,0,272.1,-277.7,0,348.5,-407.6,1,461.9,-533.2,0,683,-740.1,1],[0.83,166,0,1,166,-35.3,1,219.7,-125.6,0,278.8,-225.6,0,343.8,-336.4,1,429.9,-449.8,0,603,-650.1,1],[0.866,195.6,0,1,195.6,-25.7,1,237.4,-97,0,284.3,-177.3,0,337.2,-267.8,1,397.8,-359.6,0,524.7,-535.1,1],[0.894,219.9,0,1,219.9,-18.8,1,251.9,-74.5,0,288.4,-137.9,0,330.3,-210.6,1,370.4,-277.8,0,461.1,-420.7,1],[0.916,239.8,0,1,239.8,-13.4,1,263.4,-55.9,0,290.8,-104.8,0,322.8,-161.5,1,346.2,-203.9,0,407.9,-311.4,1],[0.944,265.4,0,1,265.4,-6.7,1,277.6,-30.9,0,292.1,-59,0,309.5,-91.9,1,323.3,-118.8,0,333.7,-139.1,1]]},\"place\":[-300,820],\"crown\":[[-90,110],[-44,107],[50,100.7],[150,93.9],[250,87],[350,80.3],[470,72.8],[620,64.8],[800,58],[1000,53.8],[1200,52.5],[1430,52.9],[1700,54],[2000,55],[2240,55.5],[2500,55.6],[2800,54.1],[3062,50],[3300,43.3],[3500,35.3],[3700,25.4],[3850,16.9],[3950,10.7],[4030,5.5],[4080,2.2],[4112,0]],\"frames\":[620,1430,2240,3062],\"stem\":{\"aftEndY\":3150,\"moulding\":110,\"siding\":40}}"
            },
            {
              "name": "planking",
              "ioValue": 9
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Camber Wires — CamberToWires for a camber v2 document: one longitudinal wire per section parameter of the\n * hull's swept sheet (the camber stations' points, with extra wires between them), from just above the sheer\n * down past the keel. crv.OpenWireLoft lofts a ruled strip between each pair. The wires lie on the OUTSIDE of the\n * planking (the camber surface offset outward by the planking thickness, mitred at the chine), so the skin shows\n * the boat's outer surface. Untrimmed: Hull Trim cuts the sheer, transom and centreline afterwards, as camber does.\n *\n * Laid out the way camber and the CamberInterpreter work: X along the hull (the model's Y), Y the half-breadth\n * (the model's X), Z up. The Hull Skin molecule mirrors it and turns it into the model's axes.\n */\nfunction run(lines: string = \"\", planking: number = 9): Assembly {\n  const H = hullOf(lines);\n  const vs = [0.9, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6]; // ~1 = sheer, 4 = chine (a knuckle), the keel lies near 5.5\n  const NU = 150, du = 1e-4, dv = 1e-3;\n  const sub = (a: number[], b: number[]) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\n  const cross = (a: number[], b: number[]) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];\n  const unit = (a: number[]) => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\n  const us: number[] = [];\n  for (let i = 0; i <= NU; i++) { const s = i / NU; us.push(s < 0.5 ? 2 * s * s * 0.42 + s * 0.58 : 1 - (2 * (1 - s) * (1 - s) * 0.42 + (1 - s) * 0.58)); }\n  const rows: number[][][] = vs.map(() => []);\n  for (const u of us) {\n    const ua = Math.max(u - du, 0), ub = Math.min(u + du, 1);\n    const sec = H.section(u), secA = H.section(ua), secB = H.section(ub);\n    vs.forEach((v, j) => {\n      const P = H.at(u, v, sec).w, Tu = sub(H.at(ub, v, secB).w, H.at(ua, v, secA).w);\n      // outward normal from each side of the point (they differ at the chine knuckle); mitre between them\n      const nUp = unit(cross(sub(P, H.at(u, Math.max(v - dv, 0), sec).w), Tu));\n      const nDn = unit(cross(sub(H.at(u, Math.min(v + dv, H.S - 1), sec).w, P), Tu));\n      const m = [nUp[0] + nDn[0], nUp[1] + nDn[1], nUp[2] + nDn[2]], k = planking / (1 + nUp[0] * nDn[0] + nUp[1] * nDn[1] + nUp[2] * nDn[2]);\n      rows[j].push([P[1] + m[1] * k, P[0] + m[0] * k, P[2] + m[2] * k]); // (model Y, model X, Z), pushed outward\n    });\n  }\n  // even ~25 mm spacing along each wire (the sweep bunches points up near the bow), then CamberToWires' own fit\n  const even = (p0: number[][]) => {\n    const L = [0];\n    for (let i = 1; i < p0.length; i++) L.push(L[i - 1] + Math.hypot(p0[i][0] - p0[i - 1][0], p0[i][1] - p0[i - 1][1], p0[i][2] - p0[i - 1][2]));\n    const n = Math.max(20, Math.round(L[L.length - 1] / 25)), out: number[][] = [];\n    for (let k = 0, i = 0; k <= n; k++) {\n      const s = (L[L.length - 1] * k) / n;\n      while (i < L.length - 2 && L[i + 1] < s) i++;\n      const t = (s - L[i]) / (L[i + 1] - L[i] || 1);\n      out.push([0, 1, 2].map((c) => p0[i][c] + (p0[i + 1][c] - p0[i][c]) * t));\n    }\n    return out;\n  };\n  const wires = rows.map((pts) => new Assembly({ geometry: replicad.assembleWire([replicad.makeBSplineApproximation(even(pts), { tolerance: 1e-3, smoothing: [0.7, 1, 0.1], degMax: 6, degMin: 1 })]) }));\n  return new Assembly({ geometry: wires, color: \"#B5651D\" });\n}\n\n// ---- camber hull helpers (port of github.com/electricshipwrights/camber, document v2); the same in every hull atom ----\n// ---- camber hull evaluator (port of electricshipwrights/camber, document v2), shared by the hull code atoms ----\n// hullOf(lines) reads the Hull Lines table. World: X across (+ starboard), Y forward, Z up (mm).\nfunction hullOf(lines: string): any {\n  if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\")) throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n  const L = JSON.parse(lines), c = L.camber;\n  const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));\n  // sheer plan: clamped cubic B-spline over u ∈ [0,1], with its exact hodograph\n  const P = c.p, N = P.length, p = Math.min(3, N - 1), U: number[] = [];\n  for (let i = 0; i <= p; i++) U.push(0);\n  for (let i = 1; i < N - p; i++) U.push(i / (N - p));\n  for (let i = 0; i <= p; i++) U.push(1);\n  const boor = (Q: number[][], K: number[], g: number, u: number) => {\n    let s = g; while (s < Q.length - 1 && u >= K[s + 1]) s++;\n    const d = []; for (let j = 0; j <= g; j++) d.push(Q[s - g + j].slice());\n    for (let r = 1; r <= g; r++) for (let j = g; j >= r; j--) {\n      const i = s - g + j, den = K[i + g - r + 1] - K[i], a = den > 0 ? (u - K[i]) / den : 0;\n      d[j] = [(1 - a) * d[j - 1][0] + a * d[j][0], (1 - a) * d[j - 1][1] + a * d[j][1]];\n    }\n    return d[g];\n  };\n  const dP: number[][] = [];\n  for (let i = 0; i < N - 1; i++) { const den = U[i + p + 1] - U[i + 1]; dP.push([(p * (P[i + 1][0] - P[i][0])) / den, (p * (P[i + 1][1] - P[i][1])) / den]); }\n  const dU = U.slice(1, U.length - 1);\n  const planAt = (u: number) => boor(P, U, p, clamp(u, 0, 1 - 1e-12)), planD = (u: number) => (p < 2 ? dP[0] : boor(dP, dU, p - 1, clamp(u, 0, 1 - 1e-12)));\n  // monotone (C2 Fritsch–Carlson) PCHIP, used for the sheer trim and the knuckles\n  const pchip = (xs: number[], ys: number[]) => {\n    const n = xs.length, h: number[] = [], d: number[] = [], m = new Array(n).fill(0);\n    for (let i = 0; i < n - 1; i++) { h.push(xs[i + 1] - xs[i]); d.push((ys[i + 1] - ys[i]) / h[i]); }\n    if (n === 2) { m[0] = m[1] = d[0]; }\n    else {\n      const eio = (q: number) => q * q * q * (10 + q * (6 * q - 15)), ei = (q: number) => q * q * q * (6 + q * (3 * q - 8));\n      for (let i = 1; i < n - 1; i++) {\n        const a = d[i - 1], b = d[i];\n        if (a * b > 0) {\n          const w1 = 2 * h[i] + h[i - 1], w2 = h[i] + 2 * h[i - 1], r = Math.min(Math.abs(a), Math.abs(b)) / Math.max(Math.abs(a), Math.abs(b));\n          m[i] = ((w1 + w2) / (w1 / a + w2 / b)) * (r < 0.25 ? eio(r / 0.25) : 1);\n        }\n      }\n      const end = (h0: number, h1: number, d0: number, d1: number) => {\n        const mm = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1), s = 3 * d0;\n        if (s === 0) return 0;\n        const t = mm / s;\n        return t <= 0 ? 0 : t >= 1 ? s : t < 0.25 ? s * 0.25 * ei(t / 0.25) : t > 0.75 ? s * (1 - 0.25 * ei((1 - t) / 0.25)) : mm;\n      };\n      m[0] = end(h[0], h[1], d[0], d[1]); m[n - 1] = end(h[n - 2], h[n - 3], d[n - 2], d[n - 3]);\n    }\n    return (x: number) => {\n      x = clamp(x, xs[0], xs[n - 1]); let i = 0; while (i < n - 2 && x > xs[i + 1]) i++;\n      const H = xs[i + 1] - xs[i], t = (x - xs[i]) / H, t2 = t * t, t3 = t2 * t;\n      return (2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * H * m[i] + (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * H * m[i + 1];\n    };\n  };\n  const trimZ = pchip(c.t.map((q: number[]) => q[0]), c.t.map((q: number[]) => q[1]));\n  // Catmull-Rom chains with knuckles: the exact non-uniform conversion to cubic Béziers\n  const chain = (V: number[][], t: number[], ks: number[]) => {\n    const tan = (a: number[], b: number[], q: number[], t0: number, t1: number, t2: number) =>\n      [0, 1].map((i) => (b[i] - a[i]) / (t1 - t0) - (q[i] - a[i]) / (t2 - t0) + (q[i] - b[i]) / (t2 - t1));\n    const segs: number[][][] = [], n = V.length;\n    for (let j = 0; j < n - 1; j++) {\n      const a = V[j], b = V[j + 1], ch = [b[0] - a[0], b[1] - a[1]], dt = t[j + 1] - t[j];\n      const i1 = j > 0 ? tan(V[j - 1], a, b, t[j - 1], t[j], t[j + 1]).map((v) => v * dt) : null;\n      const i2 = j + 2 < n ? tan(a, b, V[j + 2], t[j], t[j + 1], t[j + 2]).map((v) => v * dt) : null;\n      const e1 = i2 ? [2 * ch[0] - i2[0], 2 * ch[1] - i2[1]] : ch, e2 = i1 ? [2 * ch[0] - i1[0], 2 * ch[1] - i1[1]] : ch;\n      const kp = j === 0 ? 1 : clamp(ks[j] || 0, 0, 1), kq = j + 2 === n ? 1 : clamp(ks[j + 1] || 0, 0, 1);\n      const m1 = i1 || e1, m2 = i2 || e2, t1 = [e1[0] + (ch[0] - e1[0]) * kq, e1[1] + (ch[1] - e1[1]) * kq], t2 = [e2[0] + (ch[0] - e2[0]) * kp, e2[1] + (ch[1] - e2[1]) * kp];\n      segs.push([a, [a[0] + (m1[0] + (t1[0] - m1[0]) * kp) / 3, a[1] + (m1[1] + (t1[1] - m1[1]) * kp) / 3], [b[0] - (m2[0] + (t2[0] - m2[0]) * kq) / 3, b[1] - (m2[1] + (t2[1] - m2[1]) * kq) / 3], b]);\n    }\n    return (v: number) => {\n      const c2 = clamp(v, 0, segs.length), j = Math.min(Math.floor(c2), segs.length - 1), s = c2 - j, w = 1 - s, [b0, b1, b2, b3] = segs[j];\n      return [0, 1].map((i) => w * w * w * b0[i] + 3 * w * w * s * b1[i] + 3 * w * s * s * b2[i] + s * s * s * b3[i]);\n    };\n  };\n  // stations, lofted point by point (Catmull-Rom knotted at u); knuckles lofted with PCHIP\n  const st = c.s.map((r: number[]) => ({ u: r[0], q: r.slice(1) })).sort((a: any, b: any) => a.u - b.u);\n  const S = st[0].q.length / 3, us = st.map((s: any) => s.u), K = st.length;\n  const lofts: any[] = [], kls: any[] = [];\n  for (let i = 0; i < S; i++) {\n    lofts.push(chain(st.map((s: any) => [s.q[3 * i], s.q[3 * i + 1]]), us, new Array(K).fill(0)));\n    kls.push(K > 1 ? pchip(us, st.map((s: any) => (i === 0 || i === S - 1 ? 1 : s.q[3 * i + 2]))) : () => st[0].q[3 * i + 2]);\n  }\n  const param = (u: number) => { const cu = clamp(u, us[0], us[K - 1]); let j = 0; while (j < K - 2 && cu > us[j + 1]) j++; return j + (cu - us[j]) / (us[j + 1] - us[j] || 1); };\n  const section = (u: number) => {\n    const t = param(u), pts = lofts.map((f) => f(t)), ks = kls.map((f) => clamp(f(clamp(u, us[0], us[K - 1])), 0, 1));\n    const tk = [0]; for (let i = 1; i < S; i++) tk.push(tk[i - 1] + Math.max(Math.sqrt(Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1])), 1e-6));\n    return chain(pts, tk, ks);\n  };\n  const [ta, tb] = c.tr, xTr = (z: number) => ta[0] + (tb[0] - ta[0]) * ((z - ta[1]) / (tb[1] - ta[1]));\n  const th = (c.deg * Math.PI) / 180, ct = Math.cos(th), sn = Math.sin(th), [y0, z0] = L.place;\n  // hull-frame point → world, and a point of the swept sheet: section parameter v ∈ [0, S-1] at plan parameter u\n  const world = (x: number, y: number, z: number) => [y, x * ct - z * sn + y0, x * sn + z * ct + z0];\n  const at = (u: number, v: number, sec?: any) => {\n    const a = planAt(u), d = planD(u), l = Math.hypot(d[0], d[1]) || 1, nz = (sec || section(u))(v);\n    const x = a[0] + (nz[0] * d[1]) / l, y = a[1] - (nz[0] * d[0]) / l, z = nz[1];\n    const cons = [trimZ(x) - z, y, x - xTr(z)];\n    return { x, y, z, w: world(x, y, z), cons, keep: Math.min(cons[0], cons[1], cons[2]) };\n  };\n  return { L, S, at, section, trimZ, xTr, world, planAt, ct, sn };\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Camber Wires — CamberToWires for a camber v2 document: one longitudinal wire per section parameter of the\n * hull's swept sheet (the camber stations' points, with extra wires between them), from just above the sheer\n * down past the keel. crv.OpenWireLoft lofts a ruled strip between each pair. The wires lie on the OUTSIDE of the\n * planking (the camber surface offset outward by the planking thickness, mitred at the chine), so the skin shows\n * the boat's outer surface. Untrimmed: Hull Trim cuts the sheer, transom and centreline afterwards, as camber does.\n *\n * Laid out the way camber and the CamberInterpreter work: X along the hull (the model's Y), Y the half-breadth\n * (the model's X), Z up. The Hull Skin molecule mirrors it and turns it into the model's axes.\n */\nfunction run(lines = \"\", planking = 9) {\n    const H = hullOf(lines);\n    const vs = [0.9, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6]; // ~1 = sheer, 4 = chine (a knuckle), the keel lies near 5.5\n    const NU = 150, du = 1e-4, dv = 1e-3;\n    const sub = (a, b) => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];\n    const cross = (a, b) => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];\n    const unit = (a) => { const l = Math.hypot(a[0], a[1], a[2]) || 1; return [a[0] / l, a[1] / l, a[2] / l]; };\n    const us = [];\n    for (let i = 0; i <= NU; i++) {\n        const s = i / NU;\n        us.push(s < 0.5 ? 2 * s * s * 0.42 + s * 0.58 : 1 - (2 * (1 - s) * (1 - s) * 0.42 + (1 - s) * 0.58));\n    }\n    const rows = vs.map(() => []);\n    for (const u of us) {\n        const ua = Math.max(u - du, 0), ub = Math.min(u + du, 1);\n        const sec = H.section(u), secA = H.section(ua), secB = H.section(ub);\n        vs.forEach((v, j) => {\n            const P = H.at(u, v, sec).w, Tu = sub(H.at(ub, v, secB).w, H.at(ua, v, secA).w);\n            // outward normal from each side of the point (they differ at the chine knuckle); mitre between them\n            const nUp = unit(cross(sub(P, H.at(u, Math.max(v - dv, 0), sec).w), Tu));\n            const nDn = unit(cross(sub(H.at(u, Math.min(v + dv, H.S - 1), sec).w, P), Tu));\n            const m = [nUp[0] + nDn[0], nUp[1] + nDn[1], nUp[2] + nDn[2]], k = planking / (1 + nUp[0] * nDn[0] + nUp[1] * nDn[1] + nUp[2] * nDn[2]);\n            rows[j].push([P[1] + m[1] * k, P[0] + m[0] * k, P[2] + m[2] * k]); // (model Y, model X, Z), pushed outward\n        });\n    }\n    // even ~25 mm spacing along each wire (the sweep bunches points up near the bow), then CamberToWires' own fit\n    const even = (p0) => {\n        const L = [0];\n        for (let i = 1; i < p0.length; i++)\n            L.push(L[i - 1] + Math.hypot(p0[i][0] - p0[i - 1][0], p0[i][1] - p0[i - 1][1], p0[i][2] - p0[i - 1][2]));\n        const n = Math.max(20, Math.round(L[L.length - 1] / 25)), out = [];\n        for (let k = 0, i = 0; k <= n; k++) {\n            const s = (L[L.length - 1] * k) / n;\n            while (i < L.length - 2 && L[i + 1] < s)\n                i++;\n            const t = (s - L[i]) / (L[i + 1] - L[i] || 1);\n            out.push([0, 1, 2].map((c) => p0[i][c] + (p0[i + 1][c] - p0[i][c]) * t));\n        }\n        return out;\n    };\n    const wires = rows.map((pts) => new Assembly({ geometry: replicad.assembleWire([replicad.makeBSplineApproximation(even(pts), { tolerance: 1e-3, smoothing: [0.7, 1, 0.1], degMax: 6, degMin: 1 })]) }));\n    return new Assembly({ geometry: wires, color: \"#B5651D\" });\n}\n// ---- camber hull helpers (port of github.com/electricshipwrights/camber, document v2); the same in every hull atom ----\n// ---- camber hull evaluator (port of electricshipwrights/camber, document v2), shared by the hull code atoms ----\n// hullOf(lines) reads the Hull Lines table. World: X across (+ starboard), Y forward, Z up (mm).\nfunction hullOf(lines) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines), c = L.camber;\n    const clamp = (x, a, b) => Math.min(b, Math.max(a, x));\n    // sheer plan: clamped cubic B-spline over u ∈ [0,1], with its exact hodograph\n    const P = c.p, N = P.length, p = Math.min(3, N - 1), U = [];\n    for (let i = 0; i <= p; i++)\n        U.push(0);\n    for (let i = 1; i < N - p; i++)\n        U.push(i / (N - p));\n    for (let i = 0; i <= p; i++)\n        U.push(1);\n    const boor = (Q, K, g, u) => {\n        let s = g;\n        while (s < Q.length - 1 && u >= K[s + 1])\n            s++;\n        const d = [];\n        for (let j = 0; j <= g; j++)\n            d.push(Q[s - g + j].slice());\n        for (let r = 1; r <= g; r++)\n            for (let j = g; j >= r; j--) {\n                const i = s - g + j, den = K[i + g - r + 1] - K[i], a = den > 0 ? (u - K[i]) / den : 0;\n                d[j] = [(1 - a) * d[j - 1][0] + a * d[j][0], (1 - a) * d[j - 1][1] + a * d[j][1]];\n            }\n        return d[g];\n    };\n    const dP = [];\n    for (let i = 0; i < N - 1; i++) {\n        const den = U[i + p + 1] - U[i + 1];\n        dP.push([(p * (P[i + 1][0] - P[i][0])) / den, (p * (P[i + 1][1] - P[i][1])) / den]);\n    }\n    const dU = U.slice(1, U.length - 1);\n    const planAt = (u) => boor(P, U, p, clamp(u, 0, 1 - 1e-12)), planD = (u) => (p < 2 ? dP[0] : boor(dP, dU, p - 1, clamp(u, 0, 1 - 1e-12)));\n    // monotone (C2 Fritsch–Carlson) PCHIP, used for the sheer trim and the knuckles\n    const pchip = (xs, ys) => {\n        const n = xs.length, h = [], d = [], m = new Array(n).fill(0);\n        for (let i = 0; i < n - 1; i++) {\n            h.push(xs[i + 1] - xs[i]);\n            d.push((ys[i + 1] - ys[i]) / h[i]);\n        }\n        if (n === 2) {\n            m[0] = m[1] = d[0];\n        }\n        else {\n            const eio = (q) => q * q * q * (10 + q * (6 * q - 15)), ei = (q) => q * q * q * (6 + q * (3 * q - 8));\n            for (let i = 1; i < n - 1; i++) {\n                const a = d[i - 1], b = d[i];\n                if (a * b > 0) {\n                    const w1 = 2 * h[i] + h[i - 1], w2 = h[i] + 2 * h[i - 1], r = Math.min(Math.abs(a), Math.abs(b)) / Math.max(Math.abs(a), Math.abs(b));\n                    m[i] = ((w1 + w2) / (w1 / a + w2 / b)) * (r < 0.25 ? eio(r / 0.25) : 1);\n                }\n            }\n            const end = (h0, h1, d0, d1) => {\n                const mm = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1), s = 3 * d0;\n                if (s === 0)\n                    return 0;\n                const t = mm / s;\n                return t <= 0 ? 0 : t >= 1 ? s : t < 0.25 ? s * 0.25 * ei(t / 0.25) : t > 0.75 ? s * (1 - 0.25 * ei((1 - t) / 0.25)) : mm;\n            };\n            m[0] = end(h[0], h[1], d[0], d[1]);\n            m[n - 1] = end(h[n - 2], h[n - 3], d[n - 2], d[n - 3]);\n        }\n        return (x) => {\n            x = clamp(x, xs[0], xs[n - 1]);\n            let i = 0;\n            while (i < n - 2 && x > xs[i + 1])\n                i++;\n            const H = xs[i + 1] - xs[i], t = (x - xs[i]) / H, t2 = t * t, t3 = t2 * t;\n            return (2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * H * m[i] + (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * H * m[i + 1];\n        };\n    };\n    const trimZ = pchip(c.t.map((q) => q[0]), c.t.map((q) => q[1]));\n    // Catmull-Rom chains with knuckles: the exact non-uniform conversion to cubic Béziers\n    const chain = (V, t, ks) => {\n        const tan = (a, b, q, t0, t1, t2) => [0, 1].map((i) => (b[i] - a[i]) / (t1 - t0) - (q[i] - a[i]) / (t2 - t0) + (q[i] - b[i]) / (t2 - t1));\n        const segs = [], n = V.length;\n        for (let j = 0; j < n - 1; j++) {\n            const a = V[j], b = V[j + 1], ch = [b[0] - a[0], b[1] - a[1]], dt = t[j + 1] - t[j];\n            const i1 = j > 0 ? tan(V[j - 1], a, b, t[j - 1], t[j], t[j + 1]).map((v) => v * dt) : null;\n            const i2 = j + 2 < n ? tan(a, b, V[j + 2], t[j], t[j + 1], t[j + 2]).map((v) => v * dt) : null;\n            const e1 = i2 ? [2 * ch[0] - i2[0], 2 * ch[1] - i2[1]] : ch, e2 = i1 ? [2 * ch[0] - i1[0], 2 * ch[1] - i1[1]] : ch;\n            const kp = j === 0 ? 1 : clamp(ks[j] || 0, 0, 1), kq = j + 2 === n ? 1 : clamp(ks[j + 1] || 0, 0, 1);\n            const m1 = i1 || e1, m2 = i2 || e2, t1 = [e1[0] + (ch[0] - e1[0]) * kq, e1[1] + (ch[1] - e1[1]) * kq], t2 = [e2[0] + (ch[0] - e2[0]) * kp, e2[1] + (ch[1] - e2[1]) * kp];\n            segs.push([a, [a[0] + (m1[0] + (t1[0] - m1[0]) * kp) / 3, a[1] + (m1[1] + (t1[1] - m1[1]) * kp) / 3], [b[0] - (m2[0] + (t2[0] - m2[0]) * kq) / 3, b[1] - (m2[1] + (t2[1] - m2[1]) * kq) / 3], b]);\n        }\n        return (v) => {\n            const c2 = clamp(v, 0, segs.length), j = Math.min(Math.floor(c2), segs.length - 1), s = c2 - j, w = 1 - s, [b0, b1, b2, b3] = segs[j];\n            return [0, 1].map((i) => w * w * w * b0[i] + 3 * w * w * s * b1[i] + 3 * w * s * s * b2[i] + s * s * s * b3[i]);\n        };\n    };\n    // stations, lofted point by point (Catmull-Rom knotted at u); knuckles lofted with PCHIP\n    const st = c.s.map((r) => ({ u: r[0], q: r.slice(1) })).sort((a, b) => a.u - b.u);\n    const S = st[0].q.length / 3, us = st.map((s) => s.u), K = st.length;\n    const lofts = [], kls = [];\n    for (let i = 0; i < S; i++) {\n        lofts.push(chain(st.map((s) => [s.q[3 * i], s.q[3 * i + 1]]), us, new Array(K).fill(0)));\n        kls.push(K > 1 ? pchip(us, st.map((s) => (i === 0 || i === S - 1 ? 1 : s.q[3 * i + 2]))) : () => st[0].q[3 * i + 2]);\n    }\n    const param = (u) => { const cu = clamp(u, us[0], us[K - 1]); let j = 0; while (j < K - 2 && cu > us[j + 1])\n        j++; return j + (cu - us[j]) / (us[j + 1] - us[j] || 1); };\n    const section = (u) => {\n        const t = param(u), pts = lofts.map((f) => f(t)), ks = kls.map((f) => clamp(f(clamp(u, us[0], us[K - 1])), 0, 1));\n        const tk = [0];\n        for (let i = 1; i < S; i++)\n            tk.push(tk[i - 1] + Math.max(Math.sqrt(Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1])), 1e-6));\n        return chain(pts, tk, ks);\n    };\n    const [ta, tb] = c.tr, xTr = (z) => ta[0] + (tb[0] - ta[0]) * ((z - ta[1]) / (tb[1] - ta[1]));\n    const th = (c.deg * Math.PI) / 180, ct = Math.cos(th), sn = Math.sin(th), [y0, z0] = L.place;\n    // hull-frame point → world, and a point of the swept sheet: section parameter v ∈ [0, S-1] at plan parameter u\n    const world = (x, y, z) => [y, x * ct - z * sn + y0, x * sn + z * ct + z0];\n    const at = (u, v, sec) => {\n        const a = planAt(u), d = planD(u), l = Math.hypot(d[0], d[1]) || 1, nz = (sec || section(u))(v);\n        const x = a[0] + (nz[0] * d[1]) / l, y = a[1] - (nz[0] * d[0]) / l, z = nz[1];\n        const cons = [trimZ(x) - z, y, x - xTr(z)];\n        return { x, y, z, w: world(x, y, z), cons, keep: Math.min(cons[0], cons[1], cons[2]) };\n    };\n    return { L, S, at, section, trimZ, xTr, world, planAt, ct, sn };\n}\n"
        },
