                },
                {
                  "name": "lines",
                  "ioValue": "{\"note\":\"Hull lines in mm, to the inside of the planking (the frame outlines). Measured from the reference photos.\",\"transom\":{\"keelY\":-96,\"keelZ\":184,\"rakeDeg\":14,\"chineB\":530,\"chineV\":110,\"sheerB\":645,\"sheerV\":400,\"crown\":32,\"bulge\":60},\"stations\":[{\"name\":\"Frame 8\",\"y\":535,\"keelZ\":60,\"chineB\":600,\"chineZ\":185,\"sheerB\":760,\"sheerZ\":590,\"crown\":45,\"bulge\":20},{\"name\":\"Frame 7\",\"y\":1070,\"keelZ\":0,\"chineB\":591,\"chineZ\":96,\"sheerB\":822,\"sheerZ\":608,\"crown\":55.5,\"bulge\":0},{\"name\":\"Frame 6\",\"y\":1605,\"keelZ\":0,\"chineB\":555,\"chineZ\":118,\"sheerB\":810,\"sheerZ\":630,\"crown\":54,\"bulge\":0},{\"name\":\"Frame 5\",\"y\":2140,\"keelZ\":0,\"chineB\":495,\"chineZ\":145,\"sheerB\":778,\"sheerZ\":655,\"crown\":52,\"bulge\":0},{\"name\":\"Frame 4\",\"y\":2675,\"keelZ\":0,\"chineB\":425,\"chineZ\":176,\"sheerB\":731,\"sheerZ\":680,\"crown\":50,\"bulge\":0},{\"name\":\"Frame 3\",\"y\":3210,\"keelZ\":15,\"chineB\":335,\"chineZ\":228,\"sheerB\":652,\"sheerZ\":712,\"crown\":45,\"bulge\":0},{\"name\":\"Frame 2\",\"y\":3745,\"keelZ\":95,\"chineB\":215,\"chineZ\":318,\"sheerB\":520,\"sheerZ\":758,\"crown\":35,\"bulge\":0},{\"name\":\"Frame 1\",\"y\":4280,\"keelZ\":310,\"chineB\":90,\"chineZ\":480,\"sheerB\":305,\"sheerZ\":822,\"crown\":20,\"bulge\":0},{\"name\":\"Bow\",\"y\":4540,\"keelZ\":600,\"chineB\":6,\"chineZ\":670,\"sheerB\":14,\"sheerZ\":870,\"crown\":1,\"bulge\":0}],\"keel\":[[-96,184],[200,118],[535,60],[800,20],[1070,0],[1600,0],[2200,0],[2700,0],[3000,0],[3210,15],[3500,45],[3745,95],[4000,175],[4280,310],[4450,450],[4540,600],[4590,740],[4610,880]],\"stem\":{\"aftEndY\":3300,\"moulding\":110,\"siding\":40},\"keelBatten\":{\"width\":136,\"depth\":20},\"frameBand\":68,\"frameBottomBand\":56,\"frameCornerRadius\":70}"
                },
                {
                  "name": "kind",
                  "ioValue": "bottom",
                  "currentEquation": "bottom"
                },
                {
                  "name": "fraction",
                  "ioValue": 0.41
                },
                {
                  "name": "side",
                  "ioValue": 1,
                  "currentEquation": "1"
                },
                {
