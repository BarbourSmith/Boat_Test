              ],
              "interpreterVersion": 1,
              "code": "/**\n * One longitudinal batten lofted along the inside of the camber hull (the Hull Lines table): kind \"deck\" (deck\n * batten at `fraction` of the sheer half-breadth, under the crowned deck), \"sheer\" (sheer clamp in the frames' top\n * corner), \"chine\" (chine log in the chine corner) or \"bottom\" (bottom batten at `fraction` from the keel to the\n * chine). side = 1 starboard, -1 port. It overlaps the frames slightly so the Assembly notches them.\n */\nfunction run(lines: string = \"\", kind: string = \"deck\", fraction: number = 0.5, side: number = 1,\n             width: number = 30, thickness: number = 13, startY: number = 0, endY: number = 4000): Assembly {\n  const H = hullOf(lines), ys: number[] = [];\n  const n = Math.max(8, Math.round((endY - startY) / 200));\n  for (let i = 0; i <= n; i++) ys.push(startY + ((endY - startY) * i) / n);\n  for (const f of H.L.frames || []) if (f > startY + 60 && f < endY - 60) { for (let i = ys.length - 1; i >= 0; i--) if (Math.abs(ys[i] - f) < 60) ys.splice(i, 1); ys.push(f); }\n  ys.sort((a, b) => a - b);\n  const along = (pts: number[][], i0: number, d: number) => { // point d mm along the polyline from pts[i0]\n    let rem = d;\n    for (let i = i0; i < pts.length - 1; i++) {\n      const a = pts[i], b = pts[i + 1], l = Math.hypot(b[0] - a[0], b[1] - a[1]);\n      if (l >= rem) return [a[0] + ((b[0] - a[0]) * rem) / l, a[1] + ((b[1] - a[1]) * rem) / l];\n      rem -= l;\n    }\n    return pts[pts.length - 1];\n  };\n  const sketches = ys.map((y) => {\n    const s = hullSection(H, y), P = s.pts;\n    if (P.length < 3) throw new Error(`No hull section at Y = ${Math.round(y)} for this batten; adjust startY / endY.`);\n    let pts: number[][];\n    if (kind === \"sheer\") {\n      const top = P[0], low = along(P, 0, 40), sl = (top[0] - low[0]) / (top[1] - low[1] || 1), xo = top[0] + 6;\n      pts = [[xo - thickness * sl - width, top[1] - thickness], [xo - thickness * sl, top[1] - thickness], [xo, top[1] + 4], [xo - width, top[1] + 4]];\n    } else if (kind === \"chine\") {\n      const c = P[s.chine >= 0 ? s.chine : Math.floor(P.length / 2)];\n      pts = [[c[0] - width, c[1] - 5], [c[0] + 5, c[1] - 5], [c[0] + 5, c[1] + thickness], [c[0] - width, c[1] + thickness]];\n    } else if (kind === \"bottom\") {\n      // walk the bottom from the keel toward the chine to x = fraction * chine half-breadth; lie square to it\n      const bot = P.slice(s.chine >= 0 ? s.chine : 0).reverse(), xc = bot[bot.length - 1][0] * fraction;\n      let i = 0; while (i < bot.length - 2 && bot[i + 1][0] < xc) i++;\n      const a = bot[i], b = bot[i + 1], t = (xc - a[0]) / (b[0] - a[0] || 1), cpt = [xc, a[1] + (b[1] - a[1]) * t];\n      const l = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1, ux = (b[0] - a[0]) / l, uz = (b[1] - a[1]) / l;\n      const cx = cpt[0] + 2.5 * uz, cz = cpt[1] - 2.5 * ux, A = [cx - (ux * width) / 2, cz - (uz * width) / 2], B = [cx + (ux * width) / 2, cz + (uz * width) / 2];\n      pts = [A, B, [B[0] - uz * thickness, B[1] + ux * thickness], [A[0] - uz * thickness, A[1] + ux * thickness]];\n    } else {\n      const sh = P[0], x = fraction * sh[0], z = sh[1] + hullCrown(H, y) * (1 - fraction * fraction) + 3;\n      pts = [[x - width / 2, z - thickness], [x + width / 2, z - thickness], [x + width / 2, z], [x - width / 2, z]];\n    }\n    if (side < 0) pts = pts.map((p) => [-p[0], p[1]]).reverse();\n    let pen = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++) pen = pen.lineTo(pts[i]);\n    return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n  });\n  return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n\n// ---- camber hull helpers (port of github.com/electricshipwrights/camber, document v2); the same in every hull atom ----\n// ---- camber hull evaluator (port of electricshipwrights/camber, document v2), shared by the hull code atoms ----\n// hullOf(lines) reads the Hull Lines table. World: X across (+ starboard), Y forward, Z up (mm).\nfunction hullOf(lines: string): any {\n  if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\")) throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n  const L = JSON.parse(lines), c = L.camber;\n  const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));\n  // sheer plan: clamped cubic B-spline over u ∈ [0,1], with its exact hodograph\n  const P = c.p, N = P.length, p = Math.min(3, N - 1), U: number[] = [];\n  for (let i = 0; i <= p; i++) U.push(0);\n  for (let i = 1; i < N - p; i++) U.push(i / (N - p));\n  for (let i = 0; i <= p; i++) U.push(1);\n  const boor = (Q: number[][], K: number[], g: number, u: number) => {\n    let s = g; while (s < Q.length - 1 && u >= K[s + 1]) s++;\n    const d = []; for (let j = 0; j <= g; j++) d.push(Q[s - g + j].slice());\n    for (let r = 1; r <= g; r++) for (let j = g; j >= r; j--) {\n      const i = s - g + j, den = K[i + g - r + 1] - K[i], a = den > 0 ? (u - K[i]) / den : 0;\n      d[j] = [(1 - a) * d[j - 1][0] + a * d[j][0], (1 - a) * d[j - 1][1] + a * d[j][1]];\n    }\n    return d[g];\n  };\n  const dP: number[][] = [];\n  for (let i = 0; i < N - 1; i++) { const den = U[i + p + 1] - U[i + 1]; dP.push([(p * (P[i + 1][0] - P[i][0])) / den, (p * (P[i + 1][1] - P[i][1])) / den]); }\n  const dU = U.slice(1, U.length - 1);\n  const planAt = (u: number) => boor(P, U, p, clamp(u, 0, 1 - 1e-12)), planD = (u: number) => (p < 2 ? dP[0] : boor(dP, dU, p - 1, clamp(u, 0, 1 - 1e-12)));\n  // monotone (C2 Fritsch–Carlson) PCHIP, used for the sheer trim and the knuckles\n  const pchip = (xs: number[], ys: number[]) => {\n    const n = xs.length, h: number[] = [], d: number[] = [], m = new Array(n).fill(0);\n    for (let i = 0; i < n - 1; i++) { h.push(xs[i + 1] - xs[i]); d.push((ys[i + 1] - ys[i]) / h[i]); }\n    if (n === 2) { m[0] = m[1] = d[0]; }\n    else {\n      const eio = (q: number) => q * q * q * (10 + q * (6 * q - 15)), ei = (q: number) => q * q * q * (6 + q * (3 * q - 8));\n      for (let i = 1; i < n - 1; i++) {\n        const a = d[i - 1], b = d[i];\n        if (a * b > 0) {\n          const w1 = 2 * h[i] + h[i - 1], w2 = h[i] + 2 * h[i - 1], r = Math.min(Math.abs(a), Math.abs(b)) / Math.max(Math.abs(a), Math.abs(b));\n          m[i] = ((w1 + w2) / (w1 / a + w2 / b)) * (r < 0.25 ? eio(r / 0.25) : 1);\n        }\n      }\n      const end = (h0: number, h1: number, d0: number, d1: number) => {\n        const mm = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1), s = 3 * d0;\n        if (s === 0) return 0;\n        const t = mm / s;\n        return t <= 0 ? 0 : t >= 1 ? s : t < 0.25 ? s * 0.25 * ei(t / 0.25) : t > 0.75 ? s * (1 - 0.25 * ei((1 - t) / 0.25)) : mm;\n      };\n      m[0] = end(h[0], h[1], d[0], d[1]); m[n - 1] = end(h[n - 2], h[n - 3], d[n - 2], d[n - 3]);\n    }\n    return (x: number) => {\n      x = clamp(x, xs[0], xs[n - 1]); let i = 0; while (i < n - 2 && x > xs[i + 1]) i++;\n      const H = xs[i + 1] - xs[i], t = (x - xs[i]) / H, t2 = t * t, t3 = t2 * t;\n      return (2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * H * m[i] + (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * H * m[i + 1];\n    };\n  };\n  const trimZ = pchip(c.t.map((q: number[]) => q[0]), c.t.map((q: number[]) => q[1]));\n  // Catmull-Rom chains with knuckles: the exact non-uniform conversion to cubic Béziers\n  const chain = (V: number[][], t: number[], ks: number[]) => {\n    const tan = (a: number[], b: number[], q: number[], t0: number, t1: number, t2: number) =>\n      [0, 1].map((i) => (b[i] - a[i]) / (t1 - t0) - (q[i] - a[i]) / (t2 - t0) + (q[i] - b[i]) / (t2 - t1));\n    const segs: number[][][] = [], n = V.length;\n    for (let j = 0; j < n - 1; j++) {\n      const a = V[j], b = V[j + 1], ch = [b[0] - a[0], b[1] - a[1]], dt = t[j + 1] - t[j];\n      const i1 = j > 0 ? tan(V[j - 1], a, b, t[j - 1], t[j], t[j + 1]).map((v) => v * dt) : null;\n      const i2 = j + 2 < n ? tan(a, b, V[j + 2], t[j], t[j + 1], t[j + 2]).map((v) => v * dt) : null;\n      const e1 = i2 ? [2 * ch[0] - i2[0], 2 * ch[1] - i2[1]] : ch, e2 = i1 ? [2 * ch[0] - i1[0], 2 * ch[1] - i1[1]] : ch;\n      const kp = j === 0 ? 1 : clamp(ks[j] || 0, 0, 1), kq = j + 2 === n ? 1 : clamp(ks[j + 1] || 0, 0, 1);\n      const m1 = i1 || e1, m2 = i2 || e2, t1 = [e1[0] + (ch[0] - e1[0]) * kq, e1[1] + (ch[1] - e1[1]) * kq], t2 = [e2[0] + (ch[0] - e2[0]) * kp, e2[1] + (ch[1] - e2[1]) * kp];\n      segs.push([a, [a[0] + (m1[0] + (t1[0] - m1[0]) * kp) / 3, a[1] + (m1[1] + (t1[1] - m1[1]) * kp) / 3], [b[0] - (m2[0] + (t2[0] - m2[0]) * kq) / 3, b[1] - (m2[1] + (t2[1] - m2[1]) * kq) / 3], b]);\n    }\n    return (v: number) => {\n      const c2 = clamp(v, 0, segs.length), j = Math.min(Math.floor(c2), segs.length - 1), s = c2 - j, w = 1 - s, [b0, b1, b2, b3] = segs[j];\n      return [0, 1].map((i) => w * w * w * b0[i] + 3 * w * w * s * b1[i] + 3 * w * s * s * b2[i] + s * s * s * b3[i]);\n    };\n  };\n  // stations, lofted point by point (Catmull-Rom knotted at u); knuckles lofted with PCHIP\n  const st = c.s.map((r: number[]) => ({ u: r[0], q: r.slice(1) })).sort((a: any, b: any) => a.u - b.u);\n  const S = st[0].q.length / 3, us = st.map((s: any) => s.u), K = st.length;\n  const lofts: any[] = [], kls: any[] = [];\n  for (let i = 0; i < S; i++) {\n    lofts.push(chain(st.map((s: any) => [s.q[3 * i], s.q[3 * i + 1]]), us, new Array(K).fill(0)));\n    kls.push(K > 1 ? pchip(us, st.map((s: any) => (i === 0 || i === S - 1 ? 1 : s.q[3 * i + 2]))) : () => st[0].q[3 * i + 2]);\n  }\n  const param = (u: number) => { const cu = clamp(u, us[0], us[K - 1]); let j = 0; while (j < K - 2 && cu > us[j + 1]) j++; return j + (cu - us[j]) / (us[j + 1] - us[j] || 1); };\n  const section = (u: number) => {\n    const t = param(u), pts = lofts.map((f) => f(t)), ks = kls.map((f) => clamp(f(clamp(u, us[0], us[K - 1])), 0, 1));\n    const tk = [0]; for (let i = 1; i < S; i++) tk.push(tk[i - 1] + Math.max(Math.sqrt(Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1])), 1e-6));\n    return chain(pts, tk, ks);\n  };\n  const [ta, tb] = c.tr, xTr = (z: number) => ta[0] + (tb[0] - ta[0]) * ((z - ta[1]) / (tb[1] - ta[1]));\n  const th = (c.deg * Math.PI) / 180, ct = Math.cos(th), sn = Math.sin(th), [y0, z0] = L.place;\n  // hull-frame point → world, and a point of the swept sheet: section parameter v ∈ [0, S-1] at plan parameter u\n  const world = (x: number, y: number, z: number) => [y, x * ct - z * sn + y0, x * sn + z * ct + z0];\n  const at = (u: number, v: number, sec?: any) => {\n    const a = planAt(u), d = planD(u), l = Math.hypot(d[0], d[1]) || 1, nz = (sec || section(u))(v);\n    const x = a[0] + (nz[0] * d[1]) / l, y = a[1] - (nz[0] * d[0]) / l, z = nz[1];\n    const cons = [trimZ(x) - z, y, x - xTr(z)];\n    return { x, y, z, w: world(x, y, z), cons, keep: Math.min(cons[0], cons[1], cons[2]) };\n  };\n  return { L, S, at, section, trimZ, xTr, world, planAt, ct, sn };\n}\n\n// The trimmed half-section of the hull in the world plane Y = const, inside of planking: points [X, Z] from the\n// sheer (or the transom) down to the keel, with `chine` the index of the chine knot (station point 4) or -1.\nfunction hullSection(H: any, Y: number): any {\n  const S = H.S, out: any[] = [];\n  const uFor = (v: number) => {\n    let lo = 0, hi = 1;\n    if (H.at(lo, v).w[1] > Y || H.at(hi, v).w[1] < Y) return null;\n    for (let i = 0; i < 26; i++) { const m = (lo + hi) / 2; if (H.at(m, v).w[1] < Y) lo = m; else hi = m; }\n    return (lo + hi) / 2;\n  };\n  const samples: any[] = [];\n  for (let k = 0; k <= (S - 1) * 12; k++) {\n    const v = k / 12, u = uFor(v);\n    samples.push(u === null ? null : { v, ...H.at(u, v) });\n  }\n  // where the run crosses out of the hull between an inside sample a and an outside one b: on each constraint\n  // that b breaks, the crossing nearest a\n  const cross = (a: any, b: any) => {\n    let t = 1;\n    for (let c = 0; c < 3; c++) if (b.cons[c] < 0 && a.cons[c] >= 0) t = Math.min(t, a.cons[c] / (a.cons[c] - b.cons[c]));\n    return [a.w[0] + (b.w[0] - a.w[0]) * t, a.w[2] + (b.w[2] - a.w[2]) * t, b.cons[1] < 0 && a.cons[1] >= 0 && t === a.cons[1] / (a.cons[1] - b.cons[1])];\n  };\n  let chine = -1;\n  for (let k = 0; k < samples.length; k++) {\n    const s = samples[k];\n    if (!s || s.keep < 0) continue;\n    const prev = samples[k - 1];\n    if (!out.length && prev) { const c = cross(s, prev); out.push([c[0], c[1]]); }\n    if (Math.abs(s.v - 4) < 1e-9) chine = out.length;\n    out.push([s.w[0], s.w[2]]);\n    const next = samples[k + 1];\n    if (next && next.keep < 0) { const c = cross(s, next); out.push([c[2] ? 0 : c[0], c[1]]); break; }\n  }\n  if (out.length && Math.abs(out[out.length - 1][0]) < 0.5) out[out.length - 1][0] = 0;\n  return { pts: out, chine };\n}\n\n// deck crown above the sheer at Y (from the table's crown curve)\nfunction hullCrown(H: any, Y: number): number {\n  const C = H.L.crown;\n  if (Y <= C[0][0]) return C[0][1];\n  for (let i = 1; i < C.length; i++) if (Y <= C[i][0]) return C[i - 1][1] + ((C[i][1] - C[i - 1][1]) * (Y - C[i - 1][0])) / (C[i][0] - C[i - 1][0]);\n  return C[C.length - 1][1];\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * One longitudinal batten lofted along the inside of the camber hull (the Hull Lines table): kind \"deck\" (deck\n * batten at `fraction` of the sheer half-breadth, under the crowned deck), \"sheer\" (sheer clamp in the frames' top\n * corner), \"chine\" (chine log in the chine corner) or \"bottom\" (bottom batten at `fraction` from the keel to the\n * chine). side = 1 starboard, -1 port. It overlaps the frames slightly so the Assembly notches them.\n */\nfunction run(lines = \"\", kind = \"deck\", fraction = 0.5, side = 1, width = 30, thickness = 13, startY = 0, endY = 4000) {\n    const H = hullOf(lines), ys = [];\n    const n = Math.max(8, Math.round((endY - startY) / 200));\n    for (let i = 0; i <= n; i++)\n        ys.push(startY + ((endY - startY) * i) / n);\n    for (const f of H.L.frames || [])\n        if (f > startY + 60 && f < endY - 60) {\n            for (let i = ys.length - 1; i >= 0; i--)\n                if (Math.abs(ys[i] - f) < 60)\n                    ys.splice(i, 1);\n            ys.push(f);\n        }\n    ys.sort((a, b) => a - b);\n    const along = (pts, i0, d) => {\n        let rem = d;\n        for (let i = i0; i < pts.length - 1; i++) {\n            const a = pts[i], b = pts[i + 1], l = Math.hypot(b[0] - a[0], b[1] - a[1]);\n            if (l >= rem)\n                return [a[0] + ((b[0] - a[0]) * rem) / l, a[1] + ((b[1] - a[1]) * rem) / l];\n            rem -= l;\n        }\n        return pts[pts.length - 1];\n    };\n    const sketches = ys.map((y) => {\n        const s = hullSection(H, y), P = s.pts;\n        if (P.length < 3)\n            throw new Error(`No hull section at Y = ${Math.round(y)} for this batten; adjust startY / endY.`);\n        let pts;\n        if (kind === \"sheer\") {\n            const top = P[0], low = along(P, 0, 40), sl = (top[0] - low[0]) / (top[1] - low[1] || 1), xo = top[0] + 6;\n            pts = [[xo - thickness * sl - width, top[1] - thickness], [xo - thickness * sl, top[1] - thickness], [xo, top[1] + 4], [xo - width, top[1] + 4]];\n        }\n        else if (kind === \"chine\") {\n            const c = P[s.chine >= 0 ? s.chine : Math.floor(P.length / 2)];\n            pts = [[c[0] - width, c[1] - 5], [c[0] + 5, c[1] - 5], [c[0] + 5, c[1] + thickness], [c[0] - width, c[1] + thickness]];\n        }\n        else if (kind === \"bottom\") {\n            // walk the bottom from the keel toward the chine to x = fraction * chine half-breadth; lie square to it\n            const bot = P.slice(s.chine >= 0 ? s.chine : 0).reverse(), xc = bot[bot.length - 1][0] * fraction;\n            let i = 0;\n            while (i < bot.length - 2 && bot[i + 1][0] < xc)\n                i++;\n            const a = bot[i], b = bot[i + 1], t = (xc - a[0]) / (b[0] - a[0] || 1), cpt = [xc, a[1] + (b[1] - a[1]) * t];\n            const l = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1, ux = (b[0] - a[0]) / l, uz = (b[1] - a[1]) / l;\n            const cx = cpt[0] + 2.5 * uz, cz = cpt[1] - 2.5 * ux, A = [cx - (ux * width) / 2, cz - (uz * width) / 2], B = [cx + (ux * width) / 2, cz + (uz * width) / 2];\n            pts = [A, B, [B[0] - uz * thickness, B[1] + ux * thickness], [A[0] - uz * thickness, A[1] + ux * thickness]];\n        }\n        else {\n            const sh = P[0], x = fraction * sh[0], z = sh[1] + hullCrown(H, y) * (1 - fraction * fraction) + 3;\n            pts = [[x - width / 2, z - thickness], [x + width / 2, z - thickness], [x + width / 2, z], [x - width / 2, z]];\n        }\n        if (side < 0)\n            pts = pts.map((p) => [-p[0], p[1]]).reverse();\n        let pen = replicad.draw(pts[0]);\n        for (let i = 1; i < pts.length; i++)\n            pen = pen.lineTo(pts[i]);\n        return pen.close().sketchOnPlane(\"XZ\", [0, y, 0]);\n    });\n    return new Assembly({ geometry: sketches[0].loftWith(sketches.slice(1), { ruled: false }) });\n}\n// ---- camber hull helpers (port of github.com/electricshipwrights/camber, document v2); the same in every hull atom ----\n// ---- camber hull evaluator (port of electricshipwrights/camber, document v2), shared by the hull code atoms ----\n// hullOf(lines) reads the Hull Lines table. World: X across (+ starboard), Y forward, Z up (mm).\nfunction hullOf(lines) {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines), c = L.camber;\n    const clamp = (x, a, b) => Math.min(b, Math.max(a, x));\n    // sheer plan: clamped cubic B-spline over u ∈ [0,1], with its exact hodograph\n    const P = c.p, N = P.length, p = Math.min(3, N - 1), U = [];\n    for (let i = 0; i <= p; i++)\n        U.push(0);\n    for (let i = 1; i < N - p; i++)\n        U.push(i / (N - p));\n    for (let i = 0; i <= p; i++)\n        U.push(1);\n    const boor = (Q, K, g, u) => {\n        let s = g;\n        while (s < Q.length - 1 && u >= K[s + 1])\n            s++;\n        const d = [];\n        for (let j = 0; j <= g; j++)\n            d.push(Q[s - g + j].slice());\n        for (let r = 1; r <= g; r++)\n            for (let j = g; j >= r; j--) {\n                const i = s - g + j, den = K[i + g - r + 1] - K[i], a = den > 0 ? (u - K[i]) / den : 0;\n                d[j] = [(1 - a) * d[j - 1][0] + a * d[j][0], (1 - a) * d[j - 1][1] + a * d[j][1]];\n            }\n        return d[g];\n    };\n    const dP = [];\n    for (let i = 0; i < N - 1; i++) {\n        const den = U[i + p + 1] - U[i + 1];\n        dP.push([(p * (P[i + 1][0] - P[i][0])) / den, (p * (P[i + 1][1] - P[i][1])) / den]);\n    }\n    const dU = U.slice(1, U.length - 1);\n    const planAt = (u) => boor(P, U, p, clamp(u, 0, 1 - 1e-12)), planD = (u) => (p < 2 ? dP[0] : boor(dP, dU, p - 1, clamp(u, 0, 1 - 1e-12)));\n    // monotone (C2 Fritsch–Carlson) PCHIP, used for the sheer trim and the knuckles\n    const pchip = (xs, ys) => {\n        const n = xs.length, h = [], d = [], m = new Array(n).fill(0);\n        for (let i = 0; i < n - 1; i++) {\n            h.push(xs[i + 1] - xs[i]);\n            d.push((ys[i + 1] - ys[i]) / h[i]);\n        }\n        if (n === 2) {\n            m[0] = m[1] = d[0];\n        }\n        else {\n            const eio = (q) => q * q * q * (10 + q * (6 * q - 15)), ei = (q) => q * q * q * (6 + q * (3 * q - 8));\n            for (let i = 1; i < n - 1; i++) {\n                const a = d[i - 1], b = d[i];\n                if (a * b > 0) {\n                    const w1 = 2 * h[i] + h[i - 1], w2 = h[i] + 2 * h[i - 1], r = Math.min(Math.abs(a), Math.abs(b)) / Math.max(Math.abs(a), Math.abs(b));\n                    m[i] = ((w1 + w2) / (w1 / a + w2 / b)) * (r < 0.25 ? eio(r / 0.25) : 1);\n                }\n            }\n            const end = (h0, h1, d0, d1) => {\n                const mm = ((2 * h0 + h1) * d0 - h0 * d1) / (h0 + h1), s = 3 * d0;\n                if (s === 0)\n                    return 0;\n                const t = mm / s;\n                return t <= 0 ? 0 : t >= 1 ? s : t < 0.25 ? s * 0.25 * ei(t / 0.25) : t > 0.75 ? s * (1 - 0.25 * ei((1 - t) / 0.25)) : mm;\n            };\n            m[0] = end(h[0], h[1], d[0], d[1]);\n            m[n - 1] = end(h[n - 2], h[n - 3], d[n - 2], d[n - 3]);\n        }\n        return (x) => {\n            x = clamp(x, xs[0], xs[n - 1]);\n            let i = 0;\n            while (i < n - 2 && x > xs[i + 1])\n                i++;\n            const H = xs[i + 1] - xs[i], t = (x - xs[i]) / H, t2 = t * t, t3 = t2 * t;\n            return (2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * H * m[i] + (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * H * m[i + 1];\n        };\n    };\n    const trimZ = pchip(c.t.map((q) => q[0]), c.t.map((q) => q[1]));\n    // Catmull-Rom chains with knuckles: the exact non-uniform conversion to cubic Béziers\n    const chain = (V, t, ks) => {\n        const tan = (a, b, q, t0, t1, t2) => [0, 1].map((i) => (b[i] - a[i]) / (t1 - t0) - (q[i] - a[i]) / (t2 - t0) + (q[i] - b[i]) / (t2 - t1));\n        const segs = [], n = V.length;\n        for (let j = 0; j < n - 1; j++) {\n            const a = V[j], b = V[j + 1], ch = [b[0] - a[0], b[1] - a[1]], dt = t[j + 1] - t[j];\n            const i1 = j > 0 ? tan(V[j - 1], a, b, t[j - 1], t[j], t[j + 1]).map((v) => v * dt) : null;\n            const i2 = j + 2 < n ? tan(a, b, V[j + 2], t[j], t[j + 1], t[j + 2]).map((v) => v * dt) : null;\n            const e1 = i2 ? [2 * ch[0] - i2[0], 2 * ch[1] - i2[1]] : ch, e2 = i1 ? [2 * ch[0] - i1[0], 2 * ch[1] - i1[1]] : ch;\n            const kp = j === 0 ? 1 : clamp(ks[j] || 0, 0, 1), kq = j + 2 === n ? 1 : clamp(ks[j + 1] || 0, 0, 1);\n            const m1 = i1 || e1, m2 = i2 || e2, t1 = [e1[0] + (ch[0] - e1[0]) * kq, e1[1] + (ch[1] - e1[1]) * kq], t2 = [e2[0] + (ch[0] - e2[0]) * kp, e2[1] + (ch[1] - e2[1]) * kp];\n            segs.push([a, [a[0] + (m1[0] + (t1[0] - m1[0]) * kp) / 3, a[1] + (m1[1] + (t1[1] - m1[1]) * kp) / 3], [b[0] - (m2[0] + (t2[0] - m2[0]) * kq) / 3, b[1] - (m2[1] + (t2[1] - m2[1]) * kq) / 3], b]);\n        }\n        return (v) => {\n            const c2 = clamp(v, 0, segs.length), j = Math.min(Math.floor(c2), segs.length - 1), s = c2 - j, w = 1 - s, [b0, b1, b2, b3] = segs[j];\n            return [0, 1].map((i) => w * w * w * b0[i] + 3 * w * w * s * b1[i] + 3 * w * s * s * b2[i] + s * s * s * b3[i]);\n        };\n    };\n    // stations, lofted point by point (Catmull-Rom knotted at u); knuckles lofted with PCHIP\n    const st = c.s.map((r) => ({ u: r[0], q: r.slice(1) })).sort((a, b) => a.u - b.u);\n    const S = st[0].q.length / 3, us = st.map((s) => s.u), K = st.length;\n    const lofts = [], kls = [];\n    for (let i = 0; i < S; i++) {\n        lofts.push(chain(st.map((s) => [s.q[3 * i], s.q[3 * i + 1]]), us, new Array(K).fill(0)));\n        kls.push(K > 1 ? pchip(us, st.map((s) => (i === 0 || i === S - 1 ? 1 : s.q[3 * i + 2]))) : () => st[0].q[3 * i + 2]);\n    }\n    const param = (u) => { const cu = clamp(u, us[0], us[K - 1]); let j = 0; while (j < K - 2 && cu > us[j + 1])\n        j++; return j + (cu - us[j]) / (us[j + 1] - us[j] || 1); };\n    const section = (u) => {\n        const t = param(u), pts = lofts.map((f) => f(t)), ks = kls.map((f) => clamp(f(clamp(u, us[0], us[K - 1])), 0, 1));\n        const tk = [0];\n        for (let i = 1; i < S; i++)\n            tk.push(tk[i - 1] + Math.max(Math.sqrt(Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1])), 1e-6));\n        return chain(pts, tk, ks);\n    };\n    const [ta, tb] = c.tr, xTr = (z) => ta[0] + (tb[0] - ta[0]) * ((z - ta[1]) / (tb[1] - ta[1]));\n    const th = (c.deg * Math.PI) / 180, ct = Math.cos(th), sn = Math.sin(th), [y0, z0] = L.place;\n    // hull-frame point → world, and a point of the swept sheet: section parameter v ∈ [0, S-1] at plan parameter u\n    const world = (x, y, z) => [y, x * ct - z * sn + y0, x * sn + z * ct + z0];\n    const at = (u, v, sec) => {\n        const a = planAt(u), d = planD(u), l = Math.hypot(d[0], d[1]) || 1, nz = (sec || section(u))(v);\n        const x = a[0] + (nz[0] * d[1]) / l, y = a[1] - (nz[0] * d[0]) / l, z = nz[1];\n        const cons = [trimZ(x) - z, y, x - xTr(z)];\n        return { x, y, z, w: world(x, y, z), cons, keep: Math.min(cons[0], cons[1], cons[2]) };\n    };\n    return { L, S, at, section, trimZ, xTr, world, planAt, ct, sn };\n}\n// The trimmed half-section of the hull in the world plane Y = const, inside of planking: points [X, Z] from the\n// sheer (or the transom) down to the keel, with `chine` the index of the chine knot (station point 4) or -1.\nfunction hullSection(H, Y) {\n    const S = H.S, out = [];\n    const uFor = (v) => {\n        let lo = 0, hi = 1;\n        if (H.at(lo, v).w[1] > Y || H.at(hi, v).w[1] < Y)\n            return null;\n        for (let i = 0; i < 26; i++) {\n            const m = (lo + hi) / 2;\n            if (H.at(m, v).w[1] < Y)\n                lo = m;\n            else\n                hi = m;\n        }\n        return (lo + hi) / 2;\n    };\n    const samples = [];\n    for (let k = 0; k <= (S - 1) * 12; k++) {\n        const v = k / 12, u = uFor(v);\n        samples.push(u === null ? null : { v, ...H.at(u, v) });\n    }\n    // where the run crosses out of the hull between an inside sample a and an outside one b: on each constraint\n    // that b breaks, the crossing nearest a\n    const cross = (a, b) => {\n        let t = 1;\n        for (let c = 0; c < 3; c++)\n            if (b.cons[c] < 0 && a.cons[c] >= 0)\n                t = Math.min(t, a.cons[c] / (a.cons[c] - b.cons[c]));\n        return [a.w[0] + (b.w[0] - a.w[0]) * t, a.w[2] + (b.w[2] - a.w[2]) * t, b.cons[1] < 0 && a.cons[1] >= 0 && t === a.cons[1] / (a.cons[1] - b.cons[1])];\n    };\n    let chine = -1;\n    for (let k = 0; k < samples.length; k++) {\n        const s = samples[k];\n        if (!s || s.keep < 0)\n            continue;\n        const prev = samples[k - 1];\n        if (!out.length && prev) {\n            const c = cross(s, prev);\n            out.push([c[0], c[1]]);\n        }\n        if (Math.abs(s.v - 4) < 1e-9)\n            chine = out.length;\n        out.push([s.w[0], s.w[2]]);\n        const next = samples[k + 1];\n        if (next && next.keep < 0) {\n            const c = cross(s, next);\n            out.push([c[2] ? 0 : c[0], c[1]]);\n            break;\n        }\n    }\n    if (out.length && Math.abs(out[out.length - 1][0]) < 0.5)\n        out[out.length - 1][0] = 0;\n    return { pts: out, chine };\n}\n// deck crown above the sheer at Y (from the table's crown curve)\nfunction hullCrown(H, Y) {\n    const C = H.L.crown;\n    if (Y <= C[0][0])\n        return C[0][1];\n    for (let i = 1; i < C.length; i++)\n        if (Y <= C[i][0])\n            return C[i - 1][1] + ((C[i][1] - C[i - 1][1]) * (Y - C[i - 1][0])) / (C[i][0] - C[i - 1][0]);\n    return C[C.length - 1][1];\n}\n"
