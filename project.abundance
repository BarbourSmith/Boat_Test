      "interpreterVersion": 1,
      "code": "/**\n * Hull lines for the boat, measured from the reference photos (mm). The frame, transom, stem, keel and skin\n * code atoms all read this table, so edit the boat's shape here and every part follows.\n *\n * Axes: X across (+ starboard), Y forward from the transom's deck-corner line, Z up from the baseline\n * (the keel at frame 7). Lines are to the inside of the planking, i.e. the frame outlines.\n * Each station: keel height; chine half-breadth and height; sheer (deck edge) half-breadth and height;\n * deck crown at the centreline; bulge = how far the side bows outward (tumblehome aft).\n * The transom is raked: its offsets are measured up its face from the keel (\"V\" values).\n * \"keel\" is the keel / stem profile as [Y, Z] points, ending at the stem head.\n *\n * Where the numbers come from: frame 7 is the frame being cut on the Maslow in photo 1 (scaled from the\n * Maslow 4's 380 mm base); frame 4 is the labelled frame in photos 2-3 (rectified from its round holes, scaled\n * by its batten notches); the transom, rake, sheer line, frame spacing and stem head come from photo 5's\n * perspective (vanishing points), and the stem shape from photo 4.\n */\nconst LINES = {\n  note: \"Hull lines in mm, to the inside of the planking (the frame outlines). Measured from the reference photos.\",\n  transom: { keelY: -96, keelZ: 184, rakeDeg: 14, chineB: 530, chineV: 110, sheerB: 645, sheerV: 400, crown: 32, bulge: 60 },\n  stations: [\n    { name: \"Frame 8\", y: 535,  keelZ: 60,  chineB: 600, chineZ: 185, sheerB: 760, sheerZ: 590, crown: 45,   bulge: 20 },\n    { name: \"Frame 7\", y: 1070, keelZ: 0,   chineB: 591, chineZ: 96,  sheerB: 822, sheerZ: 608, crown: 55.5, bulge: 0 },\n    { name: \"Frame 6\", y: 1605, keelZ: 0,   chineB: 555, chineZ: 118, sheerB: 810, sheerZ: 630, crown: 54,   bulge: 0 },\n    { name: \"Frame 5\", y: 2140, keelZ: 0,   chineB: 495, chineZ: 145, sheerB: 778, sheerZ: 655, crown: 52,   bulge: 0 },\n    { name: \"Frame 4\", y: 2675, keelZ: 0,   chineB: 425, chineZ: 176, sheerB: 731, sheerZ: 680, crown: 50,   bulge: 0 },\n    { name: \"Frame 3\", y: 3210, keelZ: 15,  chineB: 335, chineZ: 228, sheerB: 652, sheerZ: 712, crown: 45,   bulge: 0 },\n    { name: \"Frame 2\", y: 3745, keelZ: 95,  chineB: 215, chineZ: 318, sheerB: 520, sheerZ: 758, crown: 35,   bulge: 0 },\n    { name: \"Frame 1\", y: 4280, keelZ: 310, chineB: 90,  chineZ: 480, sheerB: 305, sheerZ: 822, crown: 20,   bulge: 0 },\n    { name: \"Bow\",     y: 4540, keelZ: 600, chineB: 6,   chineZ: 670, sheerB: 14,  sheerZ: 870, crown: 1,    bulge: 0 },\n  ],\n  keel: [[-96, 184], [200, 118], [535, 60], [800, 20], [1070, 0], [1600, 0], [2200, 0], [2700, 0], [3000, 0],\n         [3210, 15], [3500, 45], [3745, 95], [4000, 175], [4280, 310], [4450, 450], [4540, 600], [4590, 740], [4610, 880]],\n  stem: { aftEndY: 3300, moulding: 110, siding: 40 },\n  keelBatten: { width: 136, depth: 20 },\n  frameBand: 68,\n  frameBottomBand: 56,\n  frameCornerRadius: 70,\n};\n\nfunction run(): string {\n  return JSON.stringify(LINES);\n}\n",
      "compiledCode": "\"use strict\";\n/**\n * Hull lines for the boat, measured from the reference photos (mm). The frame, transom, stem, keel and skin\n * code atoms all read this table, so edit the boat's shape here and every part follows.\n *\n * Axes: X across (+ starboard), Y forward from the transom's deck-corner line, Z up from the baseline\n * (the keel at frame 7). Lines are to the inside of the planking, i.e. the frame outlines.\n * Each station: keel height; chine half-breadth and height; sheer (deck edge) half-breadth and height;\n * deck crown at the centreline; bulge = how far the side bows outward (tumblehome aft).\n * The transom is raked: its offsets are measured up its face from the keel (\"V\" values).\n * \"keel\" is the keel / stem profile as [Y, Z] points, ending at the stem head.\n *\n * Where the numbers come from: frame 7 is the frame being cut on the Maslow in photo 1 (scaled from the\n * Maslow 4's 380 mm base); frame 4 is the labelled frame in photos 2-3 (rectified from its round holes, scaled\n * by its batten notches); the transom, rake, sheer line, frame spacing and stem head come from photo 5's\n * perspective (vanishing points), and the stem shape from photo 4.\n */\nconst LINES = {\n    note: \"Hull lines in mm, to the inside of the planking (the frame outlines). Measured from the reference photos.\",\n    transom: { keelY: -96, keelZ: 184, rakeDeg: 14, chineB: 530, chineV: 110, sheerB: 645, sheerV: 400, crown: 32, bulge: 60 },\n    stations: [\n        { name: \"Frame 8\", y: 535, keelZ: 60, chineB: 600, chineZ: 185, sheerB: 760, sheerZ: 590, crown: 45, bulge: 20 },\n        { name: \"Frame 7\", y: 1070, keelZ: 0, chineB: 591, chineZ: 96, sheerB: 822, sheerZ: 608, crown: 55.5, bulge: 0 },\n        { name: \"Frame 6\", y: 1605, keelZ: 0, chineB: 555, chineZ: 118, sheerB: 810, sheerZ: 630, crown: 54, bulge: 0 },\n        { name: \"Frame 5\", y: 2140, keelZ: 0, chineB: 495, chineZ: 145, sheerB: 778, sheerZ: 655, crown: 52, bulge: 0 },\n        { name: \"Frame 4\", y: 2675, keelZ: 0, chineB: 425, chineZ: 176, sheerB: 731, sheerZ: 680, crown: 50, bulge: 0 },\n        { name: \"Frame 3\", y: 3210, keelZ: 15, chineB: 335, chineZ: 228, sheerB: 652, sheerZ: 712, crown: 45, bulge: 0 },\n        { name: \"Frame 2\", y: 3745, keelZ: 95, chineB: 215, chineZ: 318, sheerB: 520, sheerZ: 758, crown: 35, bulge: 0 },\n        { name: \"Frame 1\", y: 4280, keelZ: 310, chineB: 90, chineZ: 480, sheerB: 305, sheerZ: 822, crown: 20, bulge: 0 },\n        { name: \"Bow\", y: 4540, keelZ: 600, chineB: 6, chineZ: 670, sheerB: 14, sheerZ: 870, crown: 1, bulge: 0 },\n    ],\n    keel: [[-96, 184], [200, 118], [535, 60], [800, 20], [1070, 0], [1600, 0], [2200, 0], [2700, 0], [3000, 0],\n        [3210, 15], [3500, 45], [3745, 95], [4000, 175], [4280, 310], [4450, 450], [4540, 600], [4590, 740], [4610, 880]],\n    stem: { aftEndY: 3300, moulding: 110, siding: 40 },\n    keelBatten: { width: 136, depth: 20 },\n    frameBand: 68,\n    frameBottomBand: 56,\n    frameCornerRadius: 70,\n};\nfunction run() {\n    return JSON.stringify(LINES);\n}\n"
    },
