                {
                  "atomType": "Code",
                  "x": 0.6035,
                  "y": 0.2143,
                  "uniqueID": "id-1551345",
                  "ioValues": [
                    {
                      "name": "shape",
                      "ioValue": "__GEOMETRY_INPUT__"
                    },
                    {
                      "name": "count",
                      "ioValue": 5
                    },
                    {
                      "name": "distX",
                      "ioValue": 20
                    },
                    {
                      "name": "distY",
                      "ioValue": 0
