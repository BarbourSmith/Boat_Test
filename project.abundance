 \"z\": -270.6, \"k\": 0 }, { \"n\": 190.3, \"z\": -442.8, \"k\": 0 }, { \"n\": 286.1, \"z\": -616.3, \"k\": 1 }, { \"n\": 506, \"z\": -707.6, \"k\": 0 }, { \"n\": 879.1, \"z\": -840.6, \"k\": 1 }] },\n        { \"u\": 0.818, \"keelK\": 0, \"points\": [{ \"n\": 11.8, \"z\": 0, \"k\": 1 }, { \"n\": 11.8, \"z\": -87.3, \"k\": 1 }, { \"n\": 99.9, \"z\": -251.7, \"k\": 0 }, { \"n\": 191.9, \"z\": -421.7, \"k\": 0 }, { \"n\": 286.9, \"z\": -595.9, \"k\": 1 }, { \"n\": 496.6, \"z\": -698.9, \"k\": 0 }, { \"n\": 885.2, \"z\": -841.2, \"k\": 1 }] },\n        { \"u\": 0.862, \"keelK\": 0, \"points\": [{ \"n\": 49.4, \"z\": 0, \"k\": 1 }, { \"n\": 49.4, \"z\": -77.2, \"k\": 1 }, { \"n\": 122, \"z\": -229.1, \"k\": 0 }, { \"n\": 200.1, \"z\": -392.4, \"k\": 0 }, { \"n\": 284.3, \"z\": -565.5, \"k\": 1 }, { \"n\": 467.6, \"z\": -686.2, \"k\": 0 }, { \"n\": 889.2, \"z\": -841.6, \"k\": 1 }] },\n        { \"u\": 0.902, \"keelK\": 0, \"points\": [{ \"n\": 96.6, \"z\": 0, \"k\": 1 }, { \"n\": 96.6, \"z\": -68.4, \"k\": 1 }, { \"n\": 146.2, \"z\": -197.5, \"k\": 0 }, { \"n\": 207.2, \"z\": -346.2, \"k\": 0 }, { \"n\": 280, \"z\": -509.4, \"k\": 1 }, { \"n\": 408.6, \"z\": -635.1, \"k\": 0 }, { \"n\": 795.4, \"z\": -834.3, \"k\": 1 }] },\n        { \"u\": 0.928, \"keelK\": 0, \"points\": [{ \"n\": 162.1, \"z\": 0, \"k\": 1 }, { \"n\": 162.1, \"z\": -63.6, \"k\": 1 }, { \"n\": 191.6, \"z\": -164.9, \"k\": 0 }, { \"n\": 232.1, \"z\": -286.2, \"k\": 0 }, { \"n\": 284.1, \"z\": -433.1, \"k\": 1 }, { \"n\": 353.8, \"z\": -543.4, \"k\": 0 }, { \"n\": 636.1, \"z\": -793.6, \"k\": 1 }] },\n        { \"u\": 0.953, \"keelK\": 0, \"points\": [{ \"n\": 254.6, \"z\": 0, \"k\": 1 }, { \"n\": 254.6, \"z\": -60.7, \"k\": 1 }, { \"n\": 261.8, \"z\": -136.2, \"k\": 0 }, { \"n\": 273.8, \"z\": -219.3, \"k\": 0 }, { \"n\": 297.2, \"z\": -320.2, \"k\": 1 }, { \"n\": 311.4, \"z\": -341.1, \"k\": 0 }, { \"n\": 387.1, \"z\": -507.5, \"k\": 1 }] }\n    ]\n};\n// camber's origin in the model: world Y and Z (mm) of the plan's first point at the deck datum\nconst PLACE = [-300, 820];\n// deck crown above the sheer at the centreline, [Y, mm], read by the frames, transom and deck battens\nconst CROWN = [[-90, 110], [0, 105], [300, 70], [900, 45], [1880, 50], [2870, 55.5], [3850, 50], [4300, 15], [4400, 0]];\n// frame stations (Y of each frame's centre plane), the stem, read by the frames, keel, stem and battens\nconst PARTS = { frames: [900, 1880, 2870, 3850], stem: { aftEndY: 3400, moulding: 110, siding: 40 } };\nfunction run() {\n    const c = CAMBER, f = (v) => Math.round(v * 100) / 100;\n    return JSON.stringify({\n        camber: {\n            deg: c.deckTrimDeg,\n            p: c.sheerPlan.map((q) => [f(q.x), f(q.y)]),\n            t: c.sheerTrim.map((q) => [f(q.x), f(q.z)]),\n            tr: c.transom.map((q) => [f(q.x), f(q.z)]),\n            s: c.stations.map((s) => [s.u, ...s.points.flatMap((q) => [f(q.n), f(q.z), q.k])]),\n        },\n        place: PLACE, crown: CROWN, ...PARTS,\n    });\n}\n"
