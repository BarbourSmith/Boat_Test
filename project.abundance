              "ioValue": "{\"note\":\"Hull lines in mm, to the inside of the planking (the frame outlines). Measured from the reference photos.\",\"transom\":{\"keelY\":-96,\"keelZ\":184,\"rakeDeg\":14,\"chineB\":530,\"chineV\":110,\"sheerB\":645,\"sheerV\":400,\"crown\":32,\"bulge\":60},\"stations\":[{\"name\":\"Frame 8\",\"y\":535,\"keelZ\":60,\"chineB\":600,\"chineZ\":185,\"sheerB\":760,\"sheerZ\":590,\"crown\":45,\"bulge\":20},{\"name\":\"Frame 7\",\"y\":1070,\"keelZ\":0,\"chineB\":591,\"chineZ\":96,\"sheerB\":822,\"sheerZ\":608,\"crown\":55.5,\"bulge\":0},{\"name\":\"Frame 6\",\"y\":1605,\"keelZ\":0,\"chineB\":555,\"chineZ\":118,\"sheerB\":810,\"sheerZ\":630,\"crown\":54,\"bulge\":0},{\"name\":\"Frame 5\",\"y\":2140,\"keelZ\":0,\"chineB\":495,\"chineZ\":145,\"sheerB\":778,\"sheerZ\":655,\"crown\":52,\"bulge\":0},{\"name\":\"Frame 4\",\"y\":2675,\"keelZ\":0,\"chineB\":425,\"chineZ\":176,\"sheerB\":731,\"sheerZ\":680,\"crown\":50,\"bulge\":0},{\"name\":\"Frame 3\",\"y\":3210,\"keelZ\":15,\"chineB\":335,\"chineZ\":228,\"sheerB\":652,\"sheerZ\":712,\"crown\":45,\"bulge\":0},{\"name\":\"Frame 2\",\"y\":3745,\"keelZ\":95,\"chineB\":215,\"chineZ\":318,\"sheerB\":520,\"sheerZ\":758,\"crown\":35,\"bulge\":0},{\"name\":\"Frame 1\",\"y\":4280,\"keelZ\":310,\"chineB\":90,\"chineZ\":480,\"sheerB\":305,\"sheerZ\":822,\"crown\":20,\"bulge\":0},{\"name\":\"Bow\",\"y\":4540,\"keelZ\":600,\"chineB\":6,\"chineZ\":670,\"sheerB\":14,\"sheerZ\":870,\"crown\":1,\"bulge\":0}],\"keel\":[[-96,184],[200,118],[535,60],[800,20],[1070,0],[1600,0],[2200,0],[2700,0],[3000,0],[3210,15],[3500,45],[3745,95],[4000,175],[4280,310],[4450,450],[4540,600],[4590,740],[4610,880]],\"stem\":{\"aftEndY\":3300,\"moulding\":110,\"siding\":40},\"keelBatten\":{\"width\":136,\"depth\":20},\"frameBand\":68,\"frameBottomBand\":56,\"frameCornerRadius\":70}"
            }
          ],
          "interpreterVersion": 1,
          "code": "/**\n * Side profile of the stem (the curved forefoot piece in the photos), from the shared Hull Lines table (wired in).\n * Its outer edge follows the keel / bow profile from the scarf with the keel up to the stem head; its inner edge is\n * offset by the moulding, tapering to the scarf. Drawn with X = height (Z) and Y = fore-aft (Y), so one\n * Rotate (y -90) stands it on the centreline plane.\n */\n// Smooth keel / stem profile through the table's keel points: returns [y, z] samples from y0 to y1.\nfunction keelProfile(L: any, y0: number, y1: number, step: number): number[][] {\n  const P = L.keel;\n  const n = P.length;\n  // parametrise by cumulative chord length so the near-vertical stem face is handled\n  const s: number[] = [0];\n  for (let i = 1; i < n; i++) s.push(s[i - 1] + Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]));\n  const at = (u: number) => {\n    let i = 0;\n    while (i < n - 2 && u > s[i + 1]) i++;\n    const p0 = P[Math.max(i - 1, 0)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(i + 2, n - 1)];\n    const h = s[i + 1] - s[i], t = Math.min(Math.max((u - s[i]) / h, 0), 1), t2 = t * t, t3 = t2 * t;\n    const s0 = s[Math.max(i - 1, 0)], s3 = s[Math.min(i + 2, n - 1)];\n    const r = [0, 1].map((k) => {\n      const m1 = ((p2[k] - p0[k]) / (s[i + 1] - s0 || 1)) * h;\n      const m2 = ((p3[k] - p1[k]) / (s3 - s[i] || 1)) * h;\n      return (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n    });\n    return r;\n  };\n  const total = s[n - 1];\n  const out: number[][] = [];\n  for (let u = 0; u <= total + 1e-6; u += step) {\n    const p = at(Math.min(u, total));\n    if (p[0] >= y0 - 1e-6 && p[0] <= y1 + 1e-6) out.push(p);\n  }\n  const last = at(total);\n  if (out.length && (out[out.length - 1][0] !== last[0] || out[out.length - 1][1] !== last[1]) && last[0] <= y1 + 1e-6) out.push(last);\n  return out;\n}\nfunction run(lines: string = \"\"): Assembly {\n  if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\")) throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n  const L = JSON.parse(lines), S = L.stem;\n  const prof = keelProfile(L, S.aftEndY, 1e9, 20);\n  // the stem's outer edge stands 8 mm proud of the bow profile (inside the planking) so it clears the square-edged\n  // frames' keel apexes where the forefoot rises steeply\n  const outer = prof.map((p, i) => {\n    const a = prof[Math.max(i - 1, 0)], b = prof[Math.min(i + 1, prof.length - 1)];\n    const ty = b[0] - a[0], tz = b[1] - a[1], tl = Math.hypot(ty, tz) || 1;\n    return [p[0] + (tz / tl) * 8, p[1] - (ty / tl) * 8];\n  });\n  const inner: number[][] = [];\n  for (let i = 0; i < outer.length; i++) {\n    const a = outer[Math.max(i - 1, 0)], b = outer[Math.min(i + 1, outer.length - 1)];\n    const ty = b[0] - a[0], tz = b[1] - a[1], tl = Math.hypot(ty, tz) || 1;\n    const d = S.moulding * Math.min(1, (outer[i][0] - S.aftEndY) / 450 + 0.08); // taper into the keel scarf\n    inner.push([outer[i][0] - (tz / tl) * d, outer[i][1] + (ty / tl) * d]);\n  }\n  const loop = [...outer, ...inner.reverse()];\n  let pen = replicad.draw([loop[0][1], loop[0][0]]);\n  for (let i = 1; i < loop.length; i++) pen = pen.lineTo([loop[i][1], loop[i][0]]);\n  return new Assembly({ geometry: pen.close() });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Side profile of the stem (the curved forefoot piece in the photos), from the shared Hull Lines table (wired in).\n * Its outer edge follows the keel / bow profile from the scarf with the keel up to the stem head; its inner edge is\n * offset by the moulding, tapering to the scarf. Drawn with X = height (Z) and Y = fore-aft (Y), so one\n * Rotate (y -90) stands it on the centreline plane.\n */\n// Smooth keel / stem profile through the table's keel points: returns [y, z] samples from y0 to y1.\nfunction keelProfile(L, y0, y1, step) {\n    const P = L.keel;\n    const n = P.length;\n    // parametrise by cumulative chord length so the near-vertical stem face is handled\n    const s = [0];\n    for (let i = 1; i < n; i++)\n        s.push(s[i - 1] + Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]));\n    const at = (u) => {\n        let i = 0;\n        while (i < n - 2 && u > s[i + 1])\n            i++;\n        const p0 = P[Math.max(i - 1, 0)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(i + 2, n - 1)];\n        const h = s[i + 1] - s[i], t = Math.min(Math.max((u - s[i]) / h, 0), 1), t2 = t * t, t3 = t2 * t;\n        const s0 = s[Math.max(i - 1, 0)], s3 = s[Math.min(i + 2, n - 1)];\n        const r = [0, 1].map((k) => {\n            const m1 = ((p2[k] - p0[k]) / (s[i + 1] - s0 || 1)) * h;\n            const m2 = ((p3[k] - p1[k]) / (s3 - s[i] || 1)) * h;\n            return (2 * t3 - 3 * t2 + 1) * p1[k] + (t3 - 2 * t2 + t) * m1 + (-2 * t3 + 3 * t2) * p2[k] + (t3 - t2) * m2;\n        });\n        return r;\n    };\n    const total = s[n - 1];\n    const out = [];\n    for (let u = 0; u <= total + 1e-6; u += step) {\n        const p = at(Math.min(u, total));\n        if (p[0] >= y0 - 1e-6 && p[0] <= y1 + 1e-6)\n            out.push(p);\n    }\n    const last = at(total);\n    if (out.length && (out[out.length - 1][0] !== last[0] || out[out.length - 1][1] !== last[1]) && last[0] <= y1 + 1e-6)\n        out.push(last);\n    return out;\n}\nfunction run(lines = \"\") {\n    if (typeof lines !== \"string\" || !lines.trim().startsWith(\"{\"))\n        throw new Error(\"Connect the Hull Lines table to the Hull Lines input.\");\n    const L = JSON.parse(lines), S = L.stem;\n    const prof = keelProfile(L, S.aftEndY, 1e9, 20);\n    // the stem's outer edge stands 8 mm proud of the bow profile (inside the planking) so it clears the square-edged\n    // frames' keel apexes where the forefoot rises steeply\n    const outer = prof.map((p, i) => {\n        const a = prof[Math.max(i - 1, 0)], b = prof[Math.min(i + 1, prof.length - 1)];\n        const ty = b[0] - a[0], tz = b[1] - a[1], tl = Math.hypot(ty, tz) || 1;\n        return [p[0] + (tz / tl) * 8, p[1] - (ty / tl) * 8];\n    });\n    const inner = [];\n    for (let i = 0; i < outer.length; i++) {\n        const a = outer[Math.max(i - 1, 0)], b = outer[Math.min(i + 1, outer.length - 1)];\n        const ty = b[0] - a[0], tz = b[1] - a[1], tl = Math.hypot(ty, tz) || 1;\n        const d = S.moulding * Math.min(1, (outer[i][0] - S.aftEndY) / 450 + 0.08); // taper into the keel scarf\n        inner.push([outer[i][0] - (tz / tl) * d, outer[i][1] + (ty / tl) * d]);\n    }\n    const loop = [...outer, ...inner.reverse()];\n    let pen = replicad.draw([loop[0][1], loop[0][0]]);\n    for (let i = 1; i < loop.length; i++)\n        pen = pen.lineTo([loop[i][1], loop[i][0]]);\n    return new Assembly({ geometry: pen.close() });\n}\n"
        },
